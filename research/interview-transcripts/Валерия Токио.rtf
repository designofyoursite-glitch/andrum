\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1058 \u1086 \u1075 \u1076 \u1072  \u1088 \u1072 \u1089 \u1089 \u1082 \u1072 \u1078 \u1077 \u1084 , \u1087 \u1086 \u1095 \u1077 \u1084 \u1091  \u1074 \u1086 \u1086 \u1073 \u1097 \u1077  \u1087 \u1088 \u1080 \u1096 \u1083 \u1080  \u1082  \u1076 \u1099 \u1093 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1099 \u1084  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 \u1084  \u1080  \u1090 \u1077 \u1084 \u1077  \u1090 \u1088 \u1077 \u1074 \u1086 \u1078 \u1085 \u1086 \u1089 \u1090 \u1080 , \u1086 \u1089 \u1086 \u1073 \u1077 \u1085 \u1085 \u1086  \u1074  \u1086 \u1090 \u1085 \u1086 \u1096 \u1077 \u1085 \u1080 \u1103 \u1093 .\
\uc0\u1050 \u1089 \u1102 \u1096 \u1072 , \u1093 \u1086 \u1095 \u1077 \u1096 \u1100  \u1085 \u1072 \u1095 \u1072 \u1090 \u1100 ?\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1044 \u1072 . \u1059  \u1082 \u1072 \u1078 \u1076 \u1086 \u1081  \u1080 \u1079  \u1085 \u1072 \u1089  \u1073 \u1099 \u1083  \u1083 \u1080 \u1095 \u1085 \u1099 \u1081  \u1086 \u1087 \u1099 \u1090  \'97 \u1080 \u1089 \u1090 \u1086 \u1088 \u1080 \u1080 , \u1095 \u1077 \u1088 \u1077 \u1079  \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1077  \u1084 \u1099  \u1087 \u1086 \u1085 \u1103 \u1083 \u1080 , \u1085 \u1072 \u1089 \u1082 \u1086 \u1083 \u1100 \u1082 \u1086  \u1101 \u1090 \u1086  \u1072 \u1082 \u1090 \u1091 \u1072 \u1083 \u1100 \u1085 \u1086 .\
\uc0\u1059  \u1084 \u1077 \u1085 \u1103 , \u1085 \u1072 \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 , \u1073 \u1099 \u1083 \u1080  \u1089 \u1083 \u1086 \u1078 \u1085 \u1099 \u1077  \u1086 \u1090 \u1085 \u1086 \u1096 \u1077 \u1085 \u1080 \u1103 . \u1058 \u1086 \u1075 \u1076 \u1072  \u1103  \u1077 \u1097 \u1105  \u1085 \u1077  \u1079 \u1085 \u1072 \u1083 \u1072 , \u1095 \u1090 \u1086  \u1090 \u1072 \u1082 \u1086 \u1077  \u1090 \u1088 \u1077 \u1074 \u1086 \u1078 \u1085 \u1072 \u1103  \u1080 \u1083 \u1080  \u1080 \u1079 \u1073 \u1077 \u1075 \u1072 \u1102 \u1097 \u1072 \u1103  \u1087 \u1088 \u1080 \u1074 \u1103 \u1079 \u1072 \u1085 \u1085 \u1086 \u1089 \u1090 \u1100  \'97 \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1073 \u1099 \u1083 \u1086  \u1086 \u1097 \u1091 \u1097 \u1077 \u1085 \u1080 \u1077 , \u1095 \u1090 \u1086  \u1074 \u1089 \u1103  \u1101 \u1085 \u1077 \u1088 \u1075 \u1080 \u1103  \u1091 \u1093 \u1086 \u1076 \u1080 \u1090  \u1074  \u1086 \u1076 \u1085 \u1091  \u1089 \u1090 \u1086 \u1088 \u1086 \u1085 \u1091 .\
\uc0\u1050 \u1086 \u1075 \u1076 \u1072  \u1085 \u1072 \u1095 \u1080 \u1085 \u1072 \u1077 \u1096 \u1100  \u1101 \u1090 \u1086  \u1086 \u1073 \u1089 \u1091 \u1078 \u1076 \u1072 \u1090 \u1100  \u1089  \u1087 \u1086 \u1076 \u1088 \u1091 \u1075 \u1072 \u1084 \u1080 , \u1086 \u1082 \u1072 \u1079 \u1099 \u1074 \u1072 \u1077 \u1090 \u1089 \u1103 , \u1087 \u1086 \u1095 \u1090 \u1080  \u1091  \u1074 \u1089 \u1077 \u1093  \u1077 \u1089 \u1090 \u1100  \u1087 \u1086 \u1093 \u1086 \u1078 \u1080 \u1077  \u1089 \u1080 \u1090 \u1091 \u1072 \u1094 \u1080 \u1080 .\
\uc0\u1055 \u1086 \u1090 \u1086 \u1084  \u1091  \u1052 \u1072 \u1096 \u1080  \u1089 \u1083 \u1091 \u1095 \u1080 \u1083 \u1072 \u1089 \u1100  \u1087 \u1086 \u1093 \u1086 \u1078 \u1072 \u1103  \u1080 \u1089 \u1090 \u1086 \u1088 \u1080 \u1103 , \u1080  \u1084 \u1099  \u1087 \u1086 \u1085 \u1103 \u1083 \u1080 : \u1074 \u1089 \u1105 , \u1074 \u1086 \u1090  \u1086 \u1085 \u1086 , \u1074 \u1086 \u1090  \u1090 \u1091 \u1076 \u1072  \u1085 \u1091 \u1078 \u1085 \u1086  \u1080 \u1076 \u1090 \u1080 .\
\uc0\u1047 \u1072 \u1093 \u1086 \u1090 \u1077 \u1083 \u1086 \u1089 \u1100  \u1089 \u1086 \u1079 \u1076 \u1072 \u1090 \u1100  \u1095 \u1090 \u1086 -\u1090 \u1086  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086 \u1077  \u1080  \u1076 \u1077 \u1081 \u1089 \u1090 \u1074 \u1077 \u1085 \u1085 \u1086 \u1077  \'97 \u1080 \u1085 \u1089 \u1090 \u1088 \u1091 \u1084 \u1077 \u1085 \u1090 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1081  \u1084 \u1086 \u1078 \u1085 \u1086  \u1080 \u1089 \u1087 \u1086 \u1083 \u1100 \u1079 \u1086 \u1074 \u1072 \u1090 \u1100  \u1087 \u1088 \u1103 \u1084 \u1086  \'ab\u1085 \u1072  \u1079 \u1077 \u1084 \u1083 \u1077 \'bb, \u1074  \u1084 \u1086 \u1084 \u1077 \u1085 \u1090 \u1077 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1090 \u1088 \u1077 \u1074 \u1086 \u1075 \u1072  \u1087 \u1086 \u1076 \u1085 \u1080 \u1084 \u1072 \u1077 \u1090 \u1089 \u1103 .\
\uc0\u1071  \u1089 \u1072 \u1084 \u1072  \u1079 \u1072 \u1082 \u1086 \u1085 \u1095 \u1080 \u1083 \u1072  \u1082 \u1091 \u1088 \u1089  \u1087 \u1086  \u1076 \u1099 \u1093 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1099 \u1084  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 \u1084 , \u1080  \u1090 \u1077 \u1087 \u1077 \u1088 \u1100  \u1080 \u1089 \u1087 \u1086 \u1083 \u1100 \u1079 \u1091 \u1102  \u1080 \u1093 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1085 \u1072 \u1074 \u1086 \u1076 \u1080 \u1090 \u1100  \u1087 \u1086 \u1088 \u1103 \u1076 \u1086 \u1082  \u1074  \u1087 \u1089 \u1080 \u1093 \u1080 \u1082 \u1077 . \u1063 \u1077 \u1088 \u1077 \u1079  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077  \u1084 \u1086 \u1078 \u1085 \u1086  \u1084 \u1085 \u1086 \u1075 \u1086 \u1077  \u1091 \u1076 \u1077 \u1088 \u1078 \u1072 \u1090 \u1100  \u1080  \u1074 \u1099 \u1088 \u1086 \u1074 \u1085 \u1103 \u1090 \u1100 .\
\uc0\u1048  \u1084 \u1099  \u1085 \u1072 \u1096 \u1083 \u1080  \u1074  \u1101 \u1090 \u1086 \u1084  \u1073 \u1072 \u1083 \u1072 \u1085 \u1089 : \u1090 \u1077 \u1084 \u1072 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1072 \u1103  \u1085 \u1072 \u1089  \u1090 \u1088 \u1086 \u1075 \u1072 \u1077 \u1090 , \u1080  \u1080 \u1085 \u1089 \u1090 \u1088 \u1091 \u1084 \u1077 \u1085 \u1090 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1084  \u1088 \u1077 \u1072 \u1083 \u1100 \u1085 \u1086  \u1084 \u1086 \u1078 \u1077 \u1084  \u1073 \u1099 \u1090 \u1100  \u1087 \u1086 \u1083 \u1077 \u1079 \u1085 \u1099 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1044 \u1072 , \u1080  \u1085 \u1072 \u1084  \u1093 \u1086 \u1090 \u1077 \u1083 \u1086 \u1089 \u1100 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1101 \u1090 \u1086 \u1090  \u1080 \u1085 \u1089 \u1090 \u1088 \u1091 \u1084 \u1077 \u1085 \u1090  \u1073 \u1099 \u1083  \u1074 \u1089 \u1077 \u1075 \u1076 \u1072  \u1087 \u1086 \u1076  \u1088 \u1091 \u1082 \u1086 \u1081 . \u1055 \u1086 \u1101 \u1090 \u1086 \u1084 \u1091  \u1101 \u1090 \u1086  \u1073 \u1091 \u1076 \u1091 \u1090  \u1072 \u1091 \u1076 \u1080 \u1086 \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080  \'97 \u1082 \u1086 \u1088 \u1086 \u1090 \u1082 \u1080 \u1077  \u1080  \u1076 \u1083 \u1080 \u1085 \u1085 \u1099 \u1077 , \u1087 \u1086  15\'9620 \u1084 \u1080 \u1085 \u1091 \u1090 , \u1074  \u1079 \u1072 \u1087 \u1080 \u1089 \u1080 . \u1063 \u1090 \u1086 \u1073 \u1099  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082  \u1084 \u1086 \u1075  \u1074 \u1082 \u1083 \u1102 \u1095 \u1080 \u1090 \u1100  \u1080 \u1093  \u1074  \u1083 \u1102 \u1073 \u1086 \u1081  \u1084 \u1086 \u1084 \u1077 \u1085 \u1090 , \u1087 \u1086 \u1076  \u1083 \u1102 \u1073 \u1091 \u1102  \u1089 \u1080 \u1090 \u1091 \u1072 \u1094 \u1080 \u1102 .\
\uc0\u1071 , \u1085 \u1072 \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 , \u1076 \u1072 \u1074 \u1085 \u1086  \u1074  \u1086 \u1090 \u1085 \u1086 \u1096 \u1077 \u1085 \u1080 \u1103 \u1093 , \u1080  \u1076 \u1072 \u1078 \u1077  \u1087 \u1088 \u1080  \u1089 \u1090 \u1072 \u1073 \u1080 \u1083 \u1100 \u1085 \u1086 \u1089 \u1090 \u1080  \u1090 \u1088 \u1077 \u1074 \u1086 \u1078 \u1085 \u1086 \u1089 \u1090 \u1100  \u1074 \u1089 \u1105  \u1088 \u1072 \u1074 \u1085 \u1086  \u1080 \u1085 \u1086 \u1075 \u1076 \u1072  \u1087 \u1086 \u1076 \u1085 \u1080 \u1084 \u1072 \u1077 \u1090 \u1089 \u1103 .\
\uc0\u1042 \u1086  \u1074 \u1088 \u1077 \u1084 \u1103  \u1073 \u1086 \u1083 \u1100 \u1096 \u1086 \u1075 \u1086  \u1082 \u1088 \u1080 \u1079 \u1080 \u1089 \u1072  \u1076 \u1099 \u1093 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1099 \u1077  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080  \u1087 \u1086 \u1084 \u1086 \u1075 \u1083 \u1080  \u1084 \u1085 \u1077  \u1073 \u1091 \u1082 \u1074 \u1072 \u1083 \u1100 \u1085 \u1086  \u1074 \u1077 \u1088 \u1085 \u1091 \u1090 \u1100 \u1089 \u1103  \u1082  \u1090 \u1077 \u1083 \u1091 , \u1074 \u1099 \u1081 \u1090 \u1080  \u1080 \u1079  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1103  \u1087 \u1088 \u1077 \u1076 \u1087 \u1072 \u1085 \u1080 \u1095 \u1077 \u1089 \u1082 \u1086 \u1081  \u1072 \u1090 \u1072 \u1082 \u1080 .\
\uc0\u1069 \u1090 \u1086  \u1087 \u1088 \u1072 \u1074 \u1076 \u1072  \u1084 \u1086 \u1097 \u1085 \u1099 \u1081  \u1080 \u1085 \u1089 \u1090 \u1088 \u1091 \u1084 \u1077 \u1085 \u1090 . \u1048  \u1084 \u1099  \u1093 \u1086 \u1090 \u1080 \u1084  \u1089 \u1076 \u1077 \u1083 \u1072 \u1090 \u1100  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090  \u1085 \u1072  \u1086 \u1089 \u1085 \u1086 \u1074 \u1077  \u1083 \u1080 \u1095 \u1085 \u1086 \u1075 \u1086  \u1086 \u1087 \u1099 \u1090 \u1072  \'97 \u1089 \u1074 \u1086 \u1077 \u1075 \u1086  \u1080  \u1076 \u1088 \u1091 \u1075 \u1080 \u1093  \u1083 \u1102 \u1076 \u1077 \u1081 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1040  \u1103  \u1074 \u1086 \u1090  \u1076 \u1091 \u1084 \u1072 \u1102 , \u1074 \u1086 \u1086 \u1073 \u1097 \u1077  \u1083 \u1080  \u1103  \u1074 \u1072 \u1096 \u1072  \u1094 \u1077 \u1083 \u1077 \u1074 \u1072 \u1103  \u1072 \u1091 \u1076 \u1080 \u1090 \u1086 \u1088 \u1080 \u1103 . \u1071  \u1078 \u1077  \u1074 \u1089 \u1103  \u1074  \u1090 \u1077 \u1084 \u1077  \'97 \u1084 \u1085 \u1086 \u1075 \u1086  \u1076 \u1099 \u1096 \u1072 \u1083 \u1072 , \u1079 \u1085 \u1072 \u1102  \u1093 \u1086 \u1083 \u1086 \u1090 \u1088 \u1086 \u1087 , \u1091 \u1095 \u1072 \u1089 \u1090 \u1074 \u1086 \u1074 \u1072 \u1083 \u1072  \u1074  \u1089 \u1077 \u1084 \u1080 \u1085 \u1072 \u1088 \u1072 \u1093 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1044 \u1072 \u1078 \u1077  \u1083 \u1091 \u1095 \u1096 \u1077 . \u1053 \u1072 \u1084  \u1074 \u1072 \u1078 \u1085 \u1086  \u1091 \u1089 \u1083 \u1099 \u1096 \u1072 \u1090 \u1100  \u1074 \u1079 \u1075 \u1083 \u1103 \u1076  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082 \u1072 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1081  \u1091 \u1078 \u1077  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1077 \u1090 , \u1082 \u1072 \u1082  \u1101 \u1090 \u1086  \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1077 \u1090 . \u1069 \u1090 \u1086  \u1087 \u1086 \u1084 \u1086 \u1078 \u1077 \u1090  \u1089 \u1076 \u1077 \u1083 \u1072 \u1090 \u1100  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090  \u1075 \u1083 \u1091 \u1073 \u1078 \u1077  \u1080  \u1090 \u1086 \u1095 \u1085 \u1077 \u1077 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1044 \u1072 ! \u1058 \u1099  \u1084 \u1086 \u1078 \u1077 \u1096 \u1100  \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1090 \u1100  \u1085 \u1077  \u1082 \u1072 \u1082  \u1085 \u1086 \u1074 \u1080 \u1095 \u1086 \u1082 , \u1072  \u1082 \u1072 \u1082  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1081  \u1079 \u1085 \u1072 \u1077 \u1090  \u1094 \u1077 \u1085 \u1085 \u1086 \u1089 \u1090 \u1100  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1103 . \u1053 \u1072 \u1084  \u1080 \u1085 \u1090 \u1077 \u1088 \u1077 \u1089 \u1085 \u1086 , \u1084 \u1086 \u1075 \u1083 \u1072  \u1073 \u1099  \u1090 \u1099  \u1087 \u1086 \u1083 \u1100 \u1079 \u1086 \u1074 \u1072 \u1090 \u1100 \u1089 \u1103  \u1090 \u1072 \u1082 \u1080 \u1084  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 \u1086 \u1084 , \u1082 \u1072 \u1082  \u1090 \u1099  \u1074 \u1099 \u1073 \u1080 \u1088 \u1072 \u1077 \u1096 \u1100  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080  \u1080  \u1087 \u1088 \u1086 \u1074 \u1086 \u1076 \u1085 \u1080 \u1082 \u1086 \u1074 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1044 \u1083 \u1103  \u1085 \u1072 \u1095 \u1072 \u1083 \u1072  \'97 \u1095 \u1077 \u1084  \u1090 \u1099  \u1079 \u1072 \u1085 \u1080 \u1084 \u1072 \u1077 \u1096 \u1100 \u1089 \u1103 , \u1075 \u1076 \u1077  \u1078 \u1080 \u1074 \u1105 \u1096 \u1100 , \u1089 \u1082 \u1086 \u1083 \u1100 \u1082 \u1086  \u1090 \u1077 \u1073 \u1077  \u1083 \u1077 \u1090 ? \u1053 \u1077 \u1084 \u1085 \u1086 \u1075 \u1086  \u1086  \u1089 \u1077 \u1073 \u1077 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1071  \u1084 \u1086 \u1076 \u1077 \u1083 \u1100 \u1077 \u1088 -\u1082 \u1086 \u1085 \u1089 \u1090 \u1088 \u1091 \u1082 \u1090 \u1086 \u1088  \u1086 \u1076 \u1077 \u1078 \u1076 \u1099 , \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1102  \u1091 \u1076 \u1072 \u1083 \u1105 \u1085 \u1085 \u1086 , \u1087 \u1086 \u1101 \u1090 \u1086 \u1084 \u1091  \u1084 \u1086 \u1075 \u1091  \u1087 \u1077 \u1088 \u1077 \u1077 \u1079 \u1078 \u1072 \u1090 \u1100 . \u1056 \u1086 \u1076 \u1080 \u1083 \u1072 \u1089 \u1100  \u1074  \u1056 \u1060 , \u1078 \u1080 \u1083 \u1072  \u1074  \u1043 \u1088 \u1091 \u1079 \u1080 \u1080 , \u1089 \u1077 \u1081 \u1095 \u1072 \u1089  \'97 \u1074  \u1071 \u1087 \u1086 \u1085 \u1080 \u1080  (\u1076 \u1086  \u1101 \u1090 \u1086 \u1075 \u1086  \u1078 \u1080 \u1083 \u1072  \u1079 \u1076 \u1077 \u1089 \u1100  16\'9617 \u1083 \u1077 \u1090 ). \u1042  2018\'962019 \u1087 \u1099 \u1090 \u1072 \u1083 \u1072 \u1089 \u1100  \u1074 \u1077 \u1088 \u1085 \u1091 \u1090 \u1100 \u1089 \u1103  \u1074  \u1052 \u1086 \u1089 \u1082 \u1074 \u1091 , \u1085 \u1086  \u1087 \u1086 \u1085 \u1103 \u1083 \u1072 , \u1095 \u1090 \u1086  \u1085 \u1077  \u1084 \u1086 \u1105 , \u1087 \u1077 \u1088 \u1077 \u1077 \u1093 \u1072 \u1083 \u1072  \u1074  2019 \u1086 \u1073 \u1088 \u1072 \u1090 \u1085 \u1086  \u1074  \u1043 \u1088 \u1091 \u1079 \u1080 \u1102 , \u1074 \u1099 \u1096 \u1083 \u1072  \u1079 \u1072 \u1084 \u1091 \u1078 , \u1074  2023 \'97 \u1088 \u1072 \u1079 \u1074 \u1086 \u1076 .\
\uc0\u1057 \u1080 \u1083 \u1100 \u1085 \u1086  \u1074 \u1099 \u1075 \u1086 \u1088 \u1077 \u1083 \u1072  \u1080  \'ab\u1079 \u1072 \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1083 \u1072 \'bb \u1076 \u1077 \u1087 \u1088 \u1077 \u1089 \u1089 \u1080 \u1102  (\u1086 \u1092 \u1080 \u1094 \u1080 \u1072 \u1083 \u1100 \u1085 \u1099 \u1081  \u1076 \u1080 \u1072 \u1075 \u1085 \u1086 \u1079 ). \u1045 \u1089 \u1090 \u1100  \u1090 \u1077 \u1088 \u1072 \u1087 \u1077 \u1074 \u1090 . \u1042  \u1082 \u1072 \u1082 \u1086 \u1081 -\u1090 \u1086  \u1084 \u1086 \u1084 \u1077 \u1085 \u1090  \u1089 \u1090 \u1072 \u1083 \u1086  \u1089 \u1086 \u1074 \u1089 \u1077 \u1084  \u1090 \u1103 \u1078 \u1077 \u1083 \u1086 : \u1085 \u1077  \u1084 \u1086 \u1075 \u1083 \u1072  \u1074 \u1089 \u1090 \u1072 \u1074 \u1072 \u1090 \u1100 , \u1077 \u1089 \u1090 \u1100 , \u1086 \u1073 \u1097 \u1072 \u1090 \u1100 \u1089 \u1103 ; \u1087 \u1091 \u1075 \u1072 \u1083  \u1089 \u1086 \u1083 \u1085 \u1077 \u1095 \u1085 \u1099 \u1081  \u1089 \u1074 \u1077 \u1090 . \u1054 \u1073 \u1088 \u1072 \u1090 \u1080 \u1083 \u1072 \u1089 \u1100  \u1082  \u1074 \u1088 \u1072 \u1095 \u1091  \u1074  \u1071 \u1087 \u1086 \u1085 \u1080 \u1080 : \u1087 \u1086 \u1087 \u1088 \u1086 \u1089 \u1080 \u1083 \u1072  \u1089 \u1072 \u1084 \u1086 \u1077  \u1084 \u1103 \u1075 \u1082 \u1086 \u1077  \u1080 \u1079  \u1084 \u1077 \u1076 \u1080 \u1082 \u1072 \u1084 \u1077 \u1085 \u1090 \u1086 \u1074  + \u1087 \u1088 \u1086 \u1076 \u1086 \u1083 \u1078 \u1072 \u1102  \u1090 \u1077 \u1088 \u1072 \u1087 \u1080 \u1102 . \u1058 \u1088 \u1080  \u1084 \u1077 \u1089 \u1103 \u1094 \u1072  \'97 \u1080  \u1103  \u1089 \u1085 \u1086 \u1074 \u1072  \u1074  \u1088 \u1077 \u1089 \u1091 \u1088 \u1089 \u1077 : \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1102 , \u1089 \u1090 \u1088 \u1086 \u1102  \u1087 \u1083 \u1072 \u1085 \u1099 , \u1077 \u1089 \u1090 \u1100  \u1087 \u1088 \u1086 \u1077 \u1082 \u1090 \u1099 . \u1047 \u1072 \u1074 \u1090 \u1088 \u1072  \u1091 \u1078 \u1077  \u1074 \u1099 \u1087 \u1080 \u1089 \u1099 \u1074 \u1072 \u1102 \u1089 \u1100  \u1089  \u1083 \u1077 \u1082 \u1072 \u1088 \u1089 \u1090 \u1074 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1058 \u1088 \u1080  \u1084 \u1077 \u1089 \u1103 \u1094 \u1072  \'97 \u1101 \u1090 \u1086  \u1086 \u1095 \u1077 \u1085 \u1100  \u1073 \u1099 \u1089 \u1090 \u1088 \u1099 \u1081  \u1074 \u1099 \u1093 \u1086 \u1076 . \u1063 \u1090 \u1086  \u1087 \u1086 \u1084 \u1086 \u1075 \u1083 \u1086  \u1073 \u1086 \u1083 \u1100 \u1096 \u1077  \u1074 \u1089 \u1077 \u1075 \u1086 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1050 \u1086 \u1084 \u1073 \u1080 \u1085 \u1072 \u1094 \u1080 \u1103 . \u1058 \u1072 \u1073 \u1083 \u1077 \u1090 \u1082 \u1080  \u1080  \u1090 \u1077 \u1088 \u1072 \u1087 \u1080 \u1103  \'97 \u1076 \u1072 , \u1085 \u1086  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077  \u1080  \u1089 \u1072 \u1084 \u1086 \u1088 \u1077 \u1075 \u1091 \u1083 \u1103 \u1094 \u1080 \u1103  \'97 \u1101 \u1090 \u1086  \u1087 \u1088 \u1072 \u1074 \u1076 \u1072  \u1087 \u1086 \u1083 \u1086 \u1074 \u1080 \u1085 \u1072  \u1091 \u1089 \u1087 \u1077 \u1093 \u1072 . \u1052 \u1099  \u1095 \u1072 \u1089 \u1090 \u1086  \u1086 \u1089 \u1090 \u1072 \u1105 \u1084 \u1089 \u1103  \u1086 \u1076 \u1080 \u1085  \u1085 \u1072  \u1086 \u1076 \u1080 \u1085  \u1089  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1077 \u1084  \'97 \u1074 \u1072 \u1078 \u1085 \u1086  \u1091 \u1084 \u1077 \u1090 \u1100  \u1087 \u1086 \u1084 \u1086 \u1075 \u1072 \u1090 \u1100  \u1089 \u1077 \u1073 \u1077  \u1079 \u1076 \u1077 \u1089 \u1100  \u1080  \u1089 \u1077 \u1081 \u1095 \u1072 \u1089 . \u1071  \u1087 \u1086 \u1076 \u1082 \u1083 \u1102 \u1095 \u1072 \u1083 \u1072  \u1074 \u1089 \u1105 : \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077 , \u1090 \u1077 \u1083 \u1077 \u1089 \u1085 \u1099 \u1077  \u1090 \u1077 \u1093 \u1085 \u1080 \u1082 \u1080 , \u1093 \u1086 \u1083 \u1086 \u1076 \u1085 \u1099 \u1077  \u1074 \u1072 \u1085 \u1085 \u1099  \'97 \u1080  \u1101 \u1090 \u1086  \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1083 \u1086 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1050 \u1072 \u1082  \u1090 \u1099  \u1074 \u1086 \u1086 \u1073 \u1097 \u1077  \u1087 \u1088 \u1080 \u1096 \u1083 \u1072  \u1082  \u1076 \u1099 \u1093 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1099 \u1084  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 \u1084 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1045 \u1097 \u1105  \u1074  2014 \u1087 \u1086 \u1079 \u1085 \u1072 \u1082 \u1086 \u1084 \u1080 \u1083 \u1072 \u1089 \u1100  \u1089  \u1082 \u1083 \u1072 \u1089 \u1089 \u1085 \u1086 \u1081  \u1090 \u1077 \u1088 \u1072 \u1087 \u1077 \u1074 \u1090 \u1082 \u1086 \u1081  (\u1075 \u1077 \u1096 \u1090 \u1072 \u1083 \u1100 \u1090  \u8594  EMDR \u1080  \u1076 \u1088 .). \u1054 \u1085 \u1072  \u1088 \u1072 \u1089 \u1089 \u1082 \u1072 \u1079 \u1072 \u1083 \u1072  \u1087 \u1088 \u1086  \u1093 \u1086 \u1083 \u1086 \u1090 \u1088 \u1086 \u1087 \u1085 \u1086 \u1077  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077  \'97 \u1082 \u1072 \u1082  \u1089 \u1086 \u1073 \u1080 \u1088 \u1072 \u1102 \u1090  \u1084 \u1091 \u1079 \u1099 \u1082 \u1091 , \u1082 \u1072 \u1082  \u1080 \u1085 \u1090 \u1077 \u1075 \u1088 \u1080 \u1088 \u1091 \u1102 \u1090  \u1072 \u1088 \u1090 -\u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080 . \u1052 \u1085 \u1077  \u1089 \u1090 \u1072 \u1083 \u1086  \u1080 \u1085 \u1090 \u1077 \u1088 \u1077 \u1089 \u1085 \u1086 , \u1103  \u1086 \u1088 \u1075 \u1072 \u1085 \u1080 \u1079 \u1086 \u1074 \u1072 \u1083 \u1072  \u1074  \u1071 \u1087 \u1086 \u1085 \u1080 \u1080  \u1087 \u1077 \u1088 \u1074 \u1099 \u1081  \u1093 \u1086 \u1083 \u1086 \u1090 \u1088 \u1086 \u1087  (\u1089 \u1085 \u1072 \u1095 \u1072 \u1083 \u1072  \u1073 \u1099 \u1083 \u1072  \u1089 \u1080 \u1090 \u1090 \u1077 \u1088 \u1086 \u1084 /\u1086 \u1088 \u1075 \u1072 \u1085 \u1080 \u1079 \u1072 \u1090 \u1086 \u1088 \u1086 \u1084 , \u1087 \u1086 \u1090 \u1086 \u1084  \u1089 \u1090 \u1072 \u1083 \u1072  \u1080  \u1076 \u1099 \u1096 \u1072 \u1090 \u1100 ). \u1042 \u1089 \u1077 \u1075 \u1086  \u1087 \u1088 \u1086 \u1074 \u1077 \u1083 \u1072  7 \u1074 \u1089 \u1090 \u1088 \u1077 \u1095 , 6 \u1088 \u1072 \u1079  \u1076 \u1099 \u1096 \u1072 \u1083 \u1072  \u1089 \u1072 \u1084 \u1072 .\
\uc0\u1057 \u1077 \u1081 \u1095 \u1072 \u1089  \u1082  \u1076 \u1083 \u1080 \u1085 \u1085 \u1099 \u1084  \'ab\u1075 \u1083 \u1091 \u1073 \u1086 \u1082 \u1080 \u1084 \'bb \u1089 \u1077 \u1089 \u1089 \u1080 \u1103 \u1084  \u1085 \u1077  \u1090 \u1103 \u1085 \u1077 \u1090  \'97 \u1090 \u1077 \u1093 \u1085 \u1080 \u1082 \u1072  \u1089 \u1080 \u1083 \u1100 \u1085 \u1072 \u1103  \u1080  \u1087 \u1086 \u1076 \u1093 \u1086 \u1076 \u1080 \u1090  \u1085 \u1077  \u1074 \u1089 \u1077 \u1084 , \u1085 \u1091 \u1078 \u1085 \u1072  \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1072 \u1103  \u1089 \u1088 \u1077 \u1076 \u1072 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1055 \u1086 \u1095 \u1077 \u1084 \u1091  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077  \u1089 \u1090 \u1072 \u1083 \u1086  \u1090 \u1074 \u1086 \u1080 \u1084  \u1088 \u1072 \u1073 \u1086 \u1095 \u1080 \u1084  \u1080 \u1085 \u1089 \u1090 \u1088 \u1091 \u1084 \u1077 \u1085 \u1090 \u1086 \u1084 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1055 \u1077 \u1088 \u1074 \u1099 \u1081  \u1086 \u1087 \u1099 \u1090  \u1073 \u1099 \u1083  \u1091 \u1076 \u1072 \u1095 \u1085 \u1099 \u1081  \'97 \u1101 \u1090 \u1086  \u1074 \u1072 \u1078 \u1085 \u1086 . \u1071  \u1091 \u1074 \u1080 \u1076 \u1077 \u1083 \u1072 , \u1085 \u1072 \u1089 \u1082 \u1086 \u1083 \u1100 \u1082 \u1086  \u1084 \u1085 \u1086 \u1075 \u1086  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082  \u1085 \u1072  \u1089 \u1072 \u1084 \u1086 \u1084  \u1076 \u1077 \u1083 \u1077  \u1087 \u1088 \u1086  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077 : \u1084 \u1086 \u1083 \u1080 \u1090 \u1074 \u1099 , \u1090 \u1080 \u1073 \u1077 \u1090 \u1089 \u1082 \u1080 \u1077  \u1087 \u1077 \u1085 \u1080 \u1103 , \u1081 \u1086 \u1075 \u1072  (\u1081 \u1086 \u1075 \u1072  \'97 \u1101 \u1090 \u1086  \u1074  \u1087 \u1077 \u1088 \u1074 \u1091 \u1102  \u1086 \u1095 \u1077 \u1088 \u1077 \u1076 \u1100  \u1087 \u1088 \u1086  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077 ). \u1055 \u1083 \u1102 \u1089  \u1089 \u1077 \u1084 \u1077 \u1081 \u1085 \u1099 \u1081  \u1082 \u1086 \u1085 \u1090 \u1077 \u1082 \u1089 \u1090 : \u1091  \u1086 \u1090 \u1094 \u1072  \u1083 \u1105 \u1090 \u1085 \u1072 \u1103  \u1096 \u1082 \u1086 \u1083 \u1072  \'97 \u1090 \u1072 \u1084  \u1091 \u1095 \u1072 \u1090  \u1089 \u1072 \u1084 \u1086 \u1088 \u1077 \u1075 \u1091 \u1083 \u1103 \u1094 \u1080 \u1080  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077 \u1084 ; \u1072 \u1088 \u1084 \u1077 \u1081 \u1089 \u1082 \u1080 \u1077  \u1090 \u1077 \u1093 \u1085 \u1080 \u1082 \u1080  \u1074 \u1088 \u1086 \u1076 \u1077  \'ab\u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1103  \u1087 \u1086  \u1082 \u1074 \u1072 \u1076 \u1088 \u1072 \u1090 \u1091 \'bb.\
\uc0\u1045 \u1097 \u1105  \u1087 \u1088 \u1080 \u1095 \u1080 \u1085 \u1072  \'97 \u1076 \u1086 \u1089 \u1090 \u1091 \u1087 \u1085 \u1086 \u1089 \u1090 \u1100 : \u1090 \u1099  \u1085 \u1077  \u1074 \u1089 \u1077 \u1075 \u1076 \u1072  \u1084 \u1086 \u1078 \u1077 \u1096 \u1100  \u1076 \u1086 \u1073 \u1088 \u1072 \u1090 \u1100 \u1089 \u1103  \u1076 \u1086  \u1090 \u1077 \u1088 \u1072 \u1087 \u1077 \u1074 \u1090 \u1072  \u1080 \u1083 \u1080  \u1083 \u1077 \u1095 \u1100  \u1085 \u1072  \u1083 \u1072 \u1074 \u1086 \u1095 \u1082 \u1091  \'ab\u1087 \u1077 \u1088 \u1077 \u1078 \u1076 \u1072 \u1090 \u1100 \'bb. \u1042  \u1090 \u1088 \u1072 \u1085 \u1089 \u1087 \u1086 \u1088 \u1090 \u1077 , \u1074  \u1084 \u1077 \u1090 \u1088 \u1086  \'97 \u1091  \u1090 \u1077 \u1073 \u1103  \u1077 \u1089 \u1090 \u1100  \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077  \u1080  \u1090 \u1077 \u1083 \u1086 . \u1055 \u1086 \u1101 \u1090 \u1086 \u1084 \u1091  \u1103  \u1089 \u1090 \u1072 \u1083 \u1072  \u1089 \u1086 \u1073 \u1080 \u1088 \u1072 \u1090 \u1100  \u1089 \u1074 \u1086 \u1081  \u1085 \u1072 \u1073 \u1086 \u1088  \u1091 \u1087 \u1088 \u1072 \u1078 \u1085 \u1077 \u1085 \u1080 \u1081 : \u1085 \u1072  \u1086 \u1089 \u1086 \u1079 \u1085 \u1072 \u1085 \u1085 \u1086 \u1089 \u1090 \u1100 , \u1085 \u1072  \u1089 \u1090 \u1072 \u1073 \u1080 \u1083 \u1080 \u1079 \u1072 \u1094 \u1080 \u1102 , \u1085 \u1072  \'ab\u1089 \u1073 \u1088 \u1086 \u1089 \'bb \u1080  \u1085 \u1072  \u1091 \u1089 \u1087 \u1086 \u1082 \u1086 \u1077 \u1085 \u1080 \u1077 . \u1044 \u1077 \u1083 \u1072 \u1083 \u1072  \u1101 \u1090 \u1086  \u1090 \u1072 \u1082  \u1095 \u1072 \u1089 \u1090 \u1086 , \u1095 \u1090 \u1086  \u1089 \u1092 \u1086 \u1088 \u1084 \u1080 \u1088 \u1086 \u1074 \u1072 \u1083 \u1089 \u1103  \u1088 \u1077 \u1092 \u1083 \u1077 \u1082 \u1089 : \u1079 \u1072 \u1084 \u1077 \u1095 \u1072 \u1102 , \u1095 \u1090 \u1086  \'ab\u1085 \u1077 \u1089 \u1105 \u1090 \'bb, \'97 \u1087 \u1077 \u1088 \u1077 \u1082 \u1083 \u1102 \u1095 \u1072 \u1102 \u1089 \u1100  \u1085 \u1072  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077 , \u1084 \u1086 \u1075 \u1091  \u1082 \u1086 \u1088 \u1086 \u1090 \u1082 \u1086  \u1087 \u1088 \u1086 \u1076 \u1099 \u1096 \u1072 \u1090 \u1100  \u1076 \u1072 \u1078 \u1077  \u1074  \u1088 \u1072 \u1079 \u1075 \u1086 \u1074 \u1086 \u1088 \u1077 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1058 \u1099  \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1083 \u1072  \u1087 \u1088 \u1086  \u1074 \u1072 \u1078 \u1085 \u1086 \u1089 \u1090 \u1100  \u1086 \u1090 \u1089 \u1083 \u1077 \u1078 \u1080 \u1074 \u1072 \u1085 \u1080 \u1103  \u1091 \u1088 \u1086 \u1074 \u1085 \u1077 \u1081  \u1085 \u1072 \u1087 \u1088 \u1103 \u1078 \u1077 \u1085 \u1080 \u1103 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1044 \u1072 . \u1042 \u1072 \u1078 \u1085 \u1086  \u1083 \u1086 \u1074 \u1080 \u1090 \u1100  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1077  \u1076 \u1086  60% \'ab\u1074 \u1085 \u1091 \u1090 \u1088 \u1077 \u1085 \u1085 \u1077 \u1075 \u1086  \u1084 \u1072 \u1085 \u1076 \u1088 \u1072 \u1078 \u1072 \'bb. \u1055 \u1086 \u1089 \u1083 \u1077  \u1101 \u1090 \u1086 \u1075 \u1086  \u1082 \u1088 \u1080 \u1090 \u1080 \u1095 \u1077 \u1089 \u1082 \u1086 \u1075 \u1086  \u1087 \u1086 \u1088 \u1086 \u1075 \u1072  \u1082 \u1086 \u1085 \u1090 \u1088 \u1086 \u1083 \u1100  \u1088 \u1077 \u1079 \u1082 \u1086  \u1087 \u1072 \u1076 \u1072 \u1077 \u1090 , \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077  \u1091 \u1078 \u1077  \u1089 \u1083 \u1072 \u1073 \u1077 \u1077  \u1087 \u1086 \u1084 \u1086 \u1075 \u1072 \u1077 \u1090  \'97 \u1085 \u1091 \u1078 \u1085 \u1099  \u1073 \u1086 \u1083 \u1077 \u1077  \'ab\u1103 \u1082 \u1086 \u1088 \u1103 \u1097 \u1080 \u1077 \'bb \u1090 \u1077 \u1083 \u1077 \u1089 \u1085 \u1099 \u1077  \u1074 \u1077 \u1097 \u1080 . \u1055 \u1086 \u1101 \u1090 \u1086 \u1084 \u1091  \u1103  \u1090 \u1088 \u1077 \u1085 \u1080 \u1088 \u1091 \u1102  \'ab\u1085 \u1072 \u1073 \u1083 \u1102 \u1076 \u1072 \u1102 \u1097 \u1077 \u1075 \u1086 \'bb \'97 \u1079 \u1072 \u1084 \u1077 \u1095 \u1072 \u1090 \u1100  \u1088 \u1072 \u1085 \u1085 \u1080 \u1077  \u1089 \u1080 \u1075 \u1085 \u1072 \u1083 \u1099  (\u1085 \u1072 \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 , \u1095 \u1090 \u1086  \u1091 \u1078 \u1077  \u1090 \u1088 \u1103 \u1089 \u1105 \u1090 \u1089 \u1103  \u1085 \u1086 \u1075 \u1072 ), \u1080  \u1090 \u1086 \u1075 \u1076 \u1072  \u1074 \u1082 \u1083 \u1102 \u1095 \u1072 \u1090 \u1100  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1050 \u1072 \u1082 \u1080 \u1077  \u1091 \u1087 \u1088 \u1072 \u1078 \u1085 \u1077 \u1085 \u1080 \u1103  \u1091  \u1090 \u1077 \u1073 \u1103  \u1074  \'ab\u1073 \u1099 \u1089 \u1090 \u1088 \u1086 \u1081  \u1072 \u1087 \u1090 \u1077 \u1095 \u1082 \u1077 \'bb?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0 \
\'97 \uc0\u1058 \u1077 \u1083 \u1077 \u1089 \u1085 \u1072 \u1103  \u1089 \u1090 \u1072 \u1073 \u1080 \u1083 \u1080 \u1079 \u1072 \u1094 \u1080 \u1103 : \u1087 \u1088 \u1086 \u1089 \u1090 \u1091 \u1082 \u1080 \u1074 \u1072 \u1085 \u1080 \u1077  (\u1083 \u1072 \u1076 \u1086 \u1085 \u1080 , \u1085 \u1086 \u1075 \u1080 , \u1075 \u1088 \u1091 \u1076 \u1085 \u1072 \u1103  \u1082 \u1083 \u1077 \u1090 \u1082 \u1072 ) \u1089  \u1092 \u1088 \u1072 \u1079 \u1086 \u1081  \'ab\u1103  \u1079 \u1076 \u1077 \u1089 \u1100 \'bb, \u1095 \u1090 \u1086 \u1073 \u1099  \u1074 \u1077 \u1088 \u1085 \u1091 \u1090 \u1100  \u1082 \u1086 \u1085 \u1090 \u1072 \u1082 \u1090  \u1089  \u1090 \u1077 \u1083 \u1086 \u1084  \u1080  \u1088 \u1077 \u1072 \u1083 \u1100 \u1085 \u1086 \u1089 \u1090 \u1100 \u1102 .\
\'97 \uc0\u1050 \u1086 \u1075 \u1076 \u1072  \u1087 \u1086 \u1090 \u1086 \u1082  \u1084 \u1099 \u1089 \u1083 \u1077 \u1081  \u1079 \u1072 \u1084 \u1077 \u1076 \u1083 \u1080 \u1083 \u1089 \u1103  \'97 \u1087 \u1086 \u1076 \u1082 \u1083 \u1102 \u1095 \u1072 \u1102  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077  (\u1079 \u1072 \u1076 \u1077 \u1088 \u1078 \u1082 \u1080 , \'ab\u1082 \u1074 \u1072 \u1076 \u1088 \u1072 \u1090 \'bb, \u1088 \u1086 \u1074 \u1085 \u1086 \u1077  \u1091 \u1076 \u1083 \u1080 \u1085 \u1105 \u1085 \u1085 \u1086 \u1077  \u1074 \u1099 \u1076 \u1086 \u1093 -\u1074 \u1076 \u1086 \u1093 ).\
\'97 \uc0\u1042  \u1089 \u1086 \u1074 \u1089 \u1077 \u1084  \u1089 \u1080 \u1083 \u1100 \u1085 \u1099 \u1093  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1103 \u1093  \u1091  \u1084 \u1077 \u1085 \u1103  \u1073 \u1099 \u1074 \u1072 \u1077 \u1090  \u1076 \u1080 \u1089 \u1089 \u1086 \u1094 \u1080 \u1072 \u1094 \u1080 \u1103  \'97 \u1090 \u1072 \u1084  \u1091 \u1078 \u1077  \u1086 \u1089 \u1085 \u1086 \u1074 \u1085 \u1086 \u1081  \u1092 \u1086 \u1082 \u1091 \u1089  \u1085 \u1072  \u1087 \u1088 \u1077 \u1076 \u1086 \u1090 \u1074 \u1088 \u1072 \u1097 \u1077 \u1085 \u1080 \u1080  \'ab\u1089 \u1088 \u1099 \u1074 \u1072 \'bb: \u1079 \u1072 \u1088 \u1072 \u1085 \u1077 \u1077  \u1088 \u1072 \u1089 \u1087 \u1086 \u1079 \u1085 \u1072 \u1074 \u1072 \u1090 \u1100  \u1090 \u1088 \u1080 \u1075 \u1075 \u1077 \u1088 \u1099 , \u1072  \u1085 \u1077  \'ab\u1075 \u1077 \u1088 \u1086 \u1080 \u1095 \u1077 \u1089 \u1082 \u1080 \'bb \u1076 \u1099 \u1096 \u1072 \u1090 \u1100 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1091 \u1078 \u1077  \u1085 \u1072 \u1082 \u1088 \u1099 \u1083 \u1086 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1058 \u1099  \u1087 \u1088 \u1086 \u1073 \u1086 \u1074 \u1072 \u1083 \u1072  \u1086 \u1085 \u1083 \u1072 \u1081 \u1085 -\u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1044 \u1072 . \u1053 \u1072 \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 , \u1091 \u1074 \u1080 \u1076 \u1077 \u1083 \u1072  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080  \u1089  \u1079 \u1072 \u1076 \u1077 \u1088 \u1078 \u1082 \u1072 \u1084 \u1080  \'97 \u1092 \u1072 \u1082 \u1090 \u1080 \u1095 \u1077 \u1089 \u1082 \u1080  \'ab\u1085 \u1072 \u1095 \u1072 \u1083 \u1086  \u1093 \u1086 \u1083 \u1086 \u1090 \u1088 \u1086 \u1087 \u1072 \'bb, \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1077 \u1077  \u1076 \u1083 \u1103  \u1086 \u1085 \u1083 \u1072 \u1081 \u1085 \u1072 . \u1055 \u1086 \u1085 \u1088 \u1072 \u1074 \u1080 \u1083 \u1086 \u1089 \u1100 , \u1095 \u1090 \u1086  \u1079 \u1072 \u1076 \u1077 \u1088 \u1078 \u1082 \u1080  \u1091 \u1076 \u1077 \u1088 \u1078 \u1080 \u1074 \u1072 \u1102 \u1090  \u1086 \u1090  \u1075 \u1080 \u1087 \u1077 \u1088 \u1074 \u1077 \u1085 \u1090 \u1080 \u1083 \u1103 \u1094 \u1080 \u1080 . \u1053 \u1086  \u1074 \u1086 \u1086 \u1073 \u1097 \u1077  \u1084 \u1085 \u1077  \u1074 \u1072 \u1078 \u1085 \u1072  \u1075 \u1088 \u1091 \u1087 \u1087 \u1072  \'97 \u1086 \u1085 \u1083 \u1072 \u1081 \u1085  \u1095 \u1072 \u1089 \u1090 \u1086  \u1086 \u1076 \u1080 \u1085 \u1086 \u1082 \u1086 .\
\uc0\u1063 \u1072 \u1097 \u1077  \u1103  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1074 \u1082 \u1083 \u1102 \u1095 \u1072 \u1102  \u1072 \u1091 \u1090 \u1077 \u1085 \u1090 \u1080 \u1095 \u1085 \u1091 \u1102  \u1084 \u1091 \u1079 \u1099 \u1082 \u1091  (\u1072 \u1083 \u1090 \u1072 \u1081 \u1089 \u1082 \u1080 \u1077  \u1085 \u1072 \u1087 \u1077 \u1074 \u1099 , \u1073 \u1072 \u1088 \u1072 \u1073 \u1072 \u1085 \u1099 ) \u1074  \u1071 \u1085 \u1076 \u1077 \u1082 \u1089 .\u1052 \u1091 \u1079 \u1099 \u1082 \u1077  \u1080  \u1076 \u1099 \u1096 \u1091  \u1089 \u1072 \u1084 \u1072 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1058 \u1099  \u1085 \u1077 \u1089 \u1082 \u1086 \u1083 \u1100 \u1082 \u1086  \u1088 \u1072 \u1079  \u1091 \u1087 \u1086 \u1084 \u1103 \u1085 \u1091 \u1083 \u1072  \u1084 \u1091 \u1079 \u1099 \u1082 \u1091 . \u1053 \u1072 \u1089 \u1082 \u1086 \u1083 \u1100 \u1082 \u1086  \u1086 \u1085 \u1072  \u1074 \u1072 \u1078 \u1085 \u1072 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1052 \u1091 \u1079 \u1099 \u1082 \u1072  \'97 \u1082 \u1072 \u1082  \u1087 \u1088 \u1086 \u1074 \u1086 \u1076 \u1085 \u1080 \u1082  \u1074  \u1088 \u1080 \u1090 \u1084  \u1080  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1077 . \u1042  \u1093 \u1086 \u1083 \u1086 \u1090 \u1088 \u1086 \u1087 \u1077  \u1079 \u1074 \u1091 \u1082  \'97 \u1084 \u1086 \u1097 \u1085 \u1099 \u1081  \u1101 \u1083 \u1077 \u1084 \u1077 \u1085 \u1090  \u1074 \u1093 \u1086 \u1076 \u1072  \u1080  \u1089 \u1086 \u1087 \u1088 \u1086 \u1074 \u1086 \u1078 \u1076 \u1077 \u1085 \u1080 \u1103 : \u1091 \u1076 \u1072 \u1088 \u1085 \u1099 \u1077 , \u1075 \u1086 \u1088 \u1083 \u1086 \u1074 \u1099 \u1077  \u1087 \u1077 \u1085 \u1080 \u1103 , \u1090 \u1080 \u1073 \u1077 \u1090 \u1089 \u1082 \u1080 \u1077  \u1095 \u1072 \u1096 \u1080 . \u1054 \u1085 \u1080  \u1087 \u1086 \u1084 \u1086 \u1075 \u1072 \u1102 \u1090  \'ab\u1089 \u1080 \u1085 \u1093 \u1088 \u1086 \u1085 \u1080 \u1079 \u1080 \u1088 \u1086 \u1074 \u1072 \u1090 \u1100 \'bb \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077  \u1080  \u1074 \u1085 \u1080 \u1084 \u1072 \u1085 \u1080 \u1077 . \u1069 \u1090 \u1086  \u1082 \u1072 \u1082  \u1090 \u1088 \u1077 \u1085 \u1080 \u1088 \u1086 \u1074 \u1082 \u1072 : \u1077 \u1089 \u1083 \u1080  \u1085 \u1077  \u1085 \u1072 \u1082 \u1072 \u1095 \u1080 \u1074 \u1072 \u1090 \u1100  \'ab\u1076 \u1099 \u1093 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1091 \u1102  \u1084 \u1099 \u1096 \u1094 \u1091 \'bb \u1074  \u1089 \u1087 \u1086 \u1082 \u1086 \u1081 \u1085 \u1086 \u1084  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1080 , \u1074  \u1082 \u1088 \u1080 \u1079 \u1080 \u1089  \u1082 \u1074 \u1072 \u1076 \u1088 \u1072 \u1090  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1085 \u1077  \u1074 \u1089 \u1087 \u1086 \u1084 \u1085 \u1080 \u1096 \u1100 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1050 \u1091 \u1087 \u1080 \u1083 \u1072  \u1073 \u1099  \u1095 \u1090 \u1086 -\u1090 \u1086  \u1086 \u1085 \u1083 \u1072 \u1081 \u1085 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1071  \u1085 \u1077  \u1087 \u1086 \u1082 \u1091 \u1087 \u1072 \u1102  \'ab\u1084 \u1072 \u1083 \u1077 \u1085 \u1100 \u1082 \u1080 \u1077 \'bb \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080  \u1088 \u1072 \u1076 \u1080  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080 . \u1050 \u1091 \u1087 \u1083 \u1102 , \u1077 \u1089 \u1083 \u1080  \u1077 \u1089 \u1090 \u1100  \u1080 \u1085 \u1090 \u1077 \u1088 \u1077 \u1089 \u1085 \u1099 \u1081  \u1101 \u1083 \u1077 \u1084 \u1077 \u1085 \u1090 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1086 \u1075 \u1086  \u1091  \u1084 \u1077 \u1085 \u1103  \u1085 \u1077 \u1090 : \u1085 \u1072 \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 , \u1089 \u1080 \u1083 \u1100 \u1085 \u1072 \u1103  \u1087 \u1088 \u1077 \u1083 \u1102 \u1076 \u1080 \u1103 -\u1087 \u1086 \u1075 \u1088 \u1091 \u1078 \u1077 \u1085 \u1080 \u1077  (\u1084 \u1103 \u1075 \u1082 \u1080 \u1081  \u1090 \u1088 \u1072 \u1085 \u1089 /\u1075 \u1080 \u1087 \u1085 \u1086 \u1090 \u1080 \u1095 \u1077 \u1089 \u1082 \u1072 \u1103  \u1080 \u1085 \u1076 \u1091 \u1082 \u1094 \u1080 \u1103  \u1087 \u1077 \u1088 \u1077 \u1076  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1077 \u1084 ), \u1089 \u1090 \u1088 \u1091 \u1082 \u1090 \u1091 \u1088 \u1080 \u1088 \u1086 \u1074 \u1072 \u1085 \u1085 \u1072 \u1103  \'ab\u1072 \u1087 \u1090 \u1077 \u1095 \u1082 \u1072  \u1076 \u1099 \u1096 \u1072 \u1090 \u1077 \u1083 \u1103 \'bb \u1076 \u1083 \u1103  \u1089 \u1072 \u1084 \u1086 \u1089 \u1090 \u1072 \u1073 \u1080 \u1083 \u1080 \u1079 \u1072 \u1094 \u1080 \u1080 , \u1087 \u1086 \u1085 \u1103 \u1090 \u1085 \u1072 \u1103  \u1083 \u1086 \u1075 \u1080 \u1082 \u1072  \u1080  \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 \u1089 \u1090 \u1100 . \u1048 , \u1082 \u1086 \u1085 \u1077 \u1095 \u1085 \u1086 , \u1076 \u1086 \u1074 \u1077 \u1088 \u1080 \u1077  \u1082  \u1074 \u1077 \u1076 \u1091 \u1097 \u1077 \u1084 \u1091  \u1080  \u1088 \u1077 \u1082 \u1086 \u1084 \u1077 \u1085 \u1076 \u1072 \u1094 \u1080 \u1103  \u1086 \u1090  \u1089 \u1074 \u1086 \u1080 \u1093 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1055 \u1088 \u1077 \u1076 \u1089 \u1090 \u1072 \u1074 \u1100 , \u1095 \u1090 \u1086  \u1084 \u1099  \u1089 \u1086 \u1079 \u1076 \u1072 \u1105 \u1084  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090  \u1089  \u1076 \u1099 \u1093 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1099 \u1084 \u1080  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 \u1084 \u1080 . \u1063 \u1090 \u1086  \u1090 \u1077 \u1073 \u1077  \u1074 \u1072 \u1078 \u1085 \u1077 \u1077  \'97 \u1095 \u1090 \u1086 \u1073 \u1099  \u1074 \u1089 \u1105  \u1096 \u1083 \u1086  \u1087 \u1086  \u1096 \u1072 \u1075 \u1072 \u1084 , \u1082 \u1072 \u1082  \u1082 \u1091 \u1088 \u1089 , \u1080 \u1083 \u1080  \u1095 \u1090 \u1086 \u1073 \u1099  \u1084 \u1086 \u1078 \u1085 \u1086  \u1073 \u1099 \u1083 \u1086  \u1074 \u1099 \u1073 \u1080 \u1088 \u1072 \u1090 \u1100  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1091  \u1087 \u1086 \u1076  \u1090 \u1077 \u1082 \u1091 \u1097 \u1077 \u1077  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1077 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1052 \u1085 \u1077  \u1073 \u1083 \u1080 \u1078 \u1077 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1077 \u1089 \u1090 \u1100  \u1074 \u1099 \u1073 \u1086 \u1088 . \u1053 \u1072 \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 : \'ab\u1089 \u1077 \u1075 \u1086 \u1076 \u1085 \u1103  \u1076 \u1099 \u1096 \u1080 \u1084  \u1089 \u1087 \u1086 \u1082 \u1086 \u1081 \u1089 \u1090 \u1074 \u1080 \u1077 \'bb, \'ab\u1076 \u1099 \u1096 \u1080 \u1084  \u1088 \u1072 \u1076 \u1086 \u1089 \u1090 \u1100 \'bb, \'ab\u1076 \u1099 \u1096 \u1080 \u1084  \u1091 \u1074 \u1077 \u1088 \u1077 \u1085 \u1085 \u1086 \u1089 \u1090 \u1100 \'bb \'97 \u1080  \u1103  \u1089 \u1072 \u1084 \u1072  \u1074 \u1099 \u1073 \u1080 \u1088 \u1072 \u1102  \u1087 \u1086  \u1085 \u1072 \u1089 \u1090 \u1088 \u1086 \u1077 \u1085 \u1080 \u1102 . \u1041 \u1077 \u1079  \u1076 \u1083 \u1080 \u1085 \u1085 \u1099 \u1093  \u1074 \u1089 \u1090 \u1091 \u1087 \u1083 \u1077 \u1085 \u1080 \u1081 , \u1073 \u1077 \u1079  \u1089 \u1086 \u1090 \u1085 \u1080  \u1089 \u1089 \u1099 \u1083 \u1086 \u1082 . \u1045 \u1089 \u1083 \u1080  \u1074 \u1080 \u1078 \u1091  \'ab96 \u1091 \u1088 \u1086 \u1082 \u1086 \u1074 \'bb \'97 \u1103  \u1085 \u1077  \u1082 \u1091 \u1087 \u1083 \u1102 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1058 \u1086  \u1077 \u1089 \u1090 \u1100  \u1092 \u1086 \u1088 \u1084 \u1072 \u1090 , \u1075 \u1076 \u1077  \u1082 \u1086 \u1088 \u1086 \u1090 \u1082 \u1086  \u1080  \u1087 \u1086  \u1089 \u1091 \u1090 \u1080 , \u1072  \u1085 \u1077  \u1087 \u1086 \u1096 \u1072 \u1075 \u1086 \u1074 \u1086  \u1080  \u1089 \u1090 \u1088 \u1086 \u1075 \u1086 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1044 \u1072 . \u1042 \u1089 \u1105  \u1090 \u1077 \u1079 \u1080 \u1089 \u1085 \u1086  \u1080  \u1103 \u1089 \u1085 \u1086 . \u1063 \u1077 \u1084  \u1087 \u1088 \u1086 \u1097 \u1077  \u1074 \u1093 \u1086 \u1076 , \u1090 \u1077 \u1084  \u1083 \u1091 \u1095 \u1096 \u1077 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1040  \u1089 \u1090 \u1080 \u1083 \u1100  \u1087 \u1086 \u1076 \u1072 \u1095 \u1080  \'97 \u1084 \u1103 \u1075 \u1082 \u1080 \u1081  \u1080  \u1073 \u1077 \u1088 \u1077 \u1078 \u1085 \u1099 \u1081  \u1080 \u1083 \u1080  \u1073 \u1086 \u1083 \u1077 \u1077  \u1076 \u1080 \u1088 \u1077 \u1082 \u1090 \u1080 \u1074 \u1085 \u1099 \u1081 , \u1089 \u1090 \u1088 \u1091 \u1082 \u1090 \u1091 \u1088 \u1080 \u1088 \u1086 \u1074 \u1072 \u1085 \u1085 \u1099 \u1081 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1071  \u1083 \u1102 \u1073 \u1083 \u1102  \u1078 \u1105 \u1089 \u1090 \u1082 \u1086 . \u1045 \u1089 \u1083 \u1080  \u1080 \u1076 \u1091  \u1074  \u1088 \u1072 \u1073 \u1086 \u1090 \u1091  \'97 \u1090 \u1086  \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1090 \u1100 . \u1053 \u1077  \u1090 \u1088 \u1072 \u1090 \u1100  \u1084 \u1086 \u1105  \u1074 \u1088 \u1077 \u1084 \u1103  \u1080  \u1089 \u1074 \u1086 \u1105 . \u1071  \u1076 \u1080 \u1089 \u1094 \u1080 \u1087 \u1083 \u1080 \u1085 \u1080 \u1088 \u1086 \u1074 \u1072 \u1085 \u1085 \u1072 \u1103 : \u1083 \u1102 \u1073 \u1083 \u1102 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1077 \u1089 \u1090 \u1100  \u1095 \u1105 \u1090 \u1082 \u1072 \u1103  \u1087 \u1083 \u1072 \u1085 \u1082 \u1072 , \u1075 \u1083 \u1091 \u1073 \u1080 \u1085 \u1072 , \u1089 \u1090 \u1088 \u1091 \u1082 \u1090 \u1091 \u1088 \u1072 . \u1047 \u1072 \u1087 \u1083 \u1072 \u1090 \u1080 \u1083 \u1072  \'97 \u1079 \u1085 \u1072 \u1095 \u1080 \u1090  \u1093 \u1086 \u1095 \u1091  \u1074 \u1099 \u1078 \u1072 \u1090 \u1100  \u1084 \u1072 \u1082 \u1089 \u1080 \u1084 \u1091 \u1084 , \u1072  \u1085 \u1077  \'ab\u1087 \u1086 \u1090 \u1091 \u1089 \u1080 \u1090 \u1100 \'bb. \u1069 \u1090 \u1086  \u1076 \u1083 \u1103  \u1084 \u1077 \u1085 \u1103  \u1090 \u1088 \u1091 \u1076 , \u1085 \u1077  \u1088 \u1072 \u1079 \u1074 \u1083 \u1077 \u1095 \u1077 \u1085 \u1080 \u1077 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1058 \u1086  \u1077 \u1089 \u1090 \u1100  \u1090 \u1099  \u1080 \u1076 \u1105 \u1096 \u1100  \u1089  \u1094 \u1077 \u1083 \u1100 \u1102 , \u1079 \u1085 \u1072 \u1077 \u1096 \u1100 , \u1095 \u1077 \u1075 \u1086  \u1093 \u1086 \u1095 \u1077 \u1096 \u1100  \u1086 \u1090  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1044 \u1072 . \u1052 \u1085 \u1077  \u1074 \u1072 \u1078 \u1077 \u1085  \u1088 \u1077 \u1079 \u1091 \u1083 \u1100 \u1090 \u1072 \u1090 , \u1086 \u1097 \u1091 \u1097 \u1077 \u1085 \u1080 \u1077 , \u1095 \u1090 \u1086  \u1103  \u1074 \u1079 \u1103 \u1083 \u1072  \u1095 \u1090 \u1086 -\u1090 \u1086  \u1094 \u1077 \u1085 \u1085 \u1086 \u1077 . \u1052 \u1103 \u1075 \u1082 \u1080 \u1081  \u1092 \u1086 \u1088 \u1084 \u1072 \u1090  \'97 \u1101 \u1090 \u1086  \u1089 \u1082 \u1086 \u1088 \u1077 \u1077  \'ab\u1089 \u1085 \u1103 \u1090 \u1100  \u1089 \u1083 \u1080 \u1074 \u1082 \u1080 \'bb. \u1040  \u1084 \u1085 \u1077  \u1080 \u1085 \u1090 \u1077 \u1088 \u1077 \u1089 \u1085 \u1072  \u1075 \u1083 \u1091 \u1073 \u1080 \u1085 \u1072 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1040  \u1077 \u1089 \u1083 \u1080  \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1090 \u1100  \u1087 \u1088 \u1086  \u1094 \u1077 \u1085 \u1091  \'97 \u1089 \u1082 \u1086 \u1083 \u1100 \u1082 \u1086  \u1090 \u1099  \u1073 \u1099  \u1079 \u1072 \u1087 \u1083 \u1072 \u1090 \u1080 \u1083 \u1072  \u1079 \u1072  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1081  \u1074 \u1082 \u1083 \u1102 \u1095 \u1072 \u1077 \u1090  \u1082 \u1086 \u1088 \u1086 \u1090 \u1082 \u1080 \u1077  \u1080  \u1075 \u1083 \u1091 \u1073 \u1086 \u1082 \u1080 \u1077  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080 , \u1087 \u1086 \u1084 \u1086 \u1075 \u1072 \u1077 \u1090  \u1089 \u1087 \u1088 \u1072 \u1074 \u1083 \u1103 \u1090 \u1100 \u1089 \u1103  \u1089  \u1090 \u1088 \u1077 \u1074 \u1086 \u1075 \u1086 \u1081  \u1080  \u1074 \u1086 \u1079 \u1074 \u1088 \u1072 \u1097 \u1072 \u1090 \u1100 \u1089 \u1103  \u1082  \u1089 \u1077 \u1073 \u1077 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1071  \u1074 \u1089 \u1077 \u1075 \u1076 \u1072  \u1087 \u1083 \u1072 \u1095 \u1091  \u1085 \u1077  \u1079 \u1072  \u1090 \u1077 \u1093 \u1085 \u1080 \u1082 \u1091 , \u1072  \u1079 \u1072  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082 \u1072 . \u1053 \u1072 \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 , \u1085 \u1072  \u1093 \u1086 \u1083 \u1086 \u1090 \u1088 \u1086 \u1087  \u1082  \u1089 \u1074 \u1086 \u1077 \u1084 \u1091  \u1090 \u1077 \u1088 \u1072 \u1087 \u1077 \u1074 \u1090 \u1091  \'97 \u1076 \u1072 , \u1087 \u1086 \u1077 \u1076 \u1091 , \u1079 \u1072 \u1087 \u1083 \u1072 \u1095 \u1091  \u1089 \u1090 \u1086  \u1076 \u1086 \u1083 \u1083 \u1072 \u1088 \u1086 \u1074  \u1079 \u1072  \u1076 \u1074 \u1072  \u1076 \u1085 \u1103 . \u1054 \u1085 \u1083 \u1072 \u1081 \u1085  \'97 \u1090 \u1086 \u1078 \u1077  \u1079 \u1072 \u1087 \u1083 \u1072 \u1095 \u1091 , \u1085 \u1086  \u1085 \u1077  \u1089 \u1090 \u1086 , \u1082 \u1086 \u1085 \u1077 \u1095 \u1085 \u1086 , \'97 \u1077 \u1089 \u1083 \u1080  \u1079 \u1085 \u1072 \u1102  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082 \u1072  \u1080 \u1083 \u1080  \u1082 \u1090 \u1086 -\u1090 \u1086  \u1087 \u1086 \u1088 \u1077 \u1082 \u1086 \u1084 \u1077 \u1085 \u1076 \u1086 \u1074 \u1072 \u1083 .\
\uc0\u1071  \u1085 \u1077  \u1087 \u1086 \u1096 \u1083 \u1072  \u1073 \u1099  \u1082  \u1089 \u1083 \u1091 \u1095 \u1072 \u1081 \u1085 \u1086 \u1084 \u1091  \u1074 \u1077 \u1076 \u1091 \u1097 \u1077 \u1084 \u1091 . \u1044 \u1083 \u1103  \u1084 \u1077 \u1085 \u1103  \u1074 \u1072 \u1078 \u1085 \u1086 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1082 \u1090 \u1086 -\u1090 \u1086  \u1080 \u1079  \u1084 \u1086 \u1080 \u1093  \u1089 \u1082 \u1072 \u1079 \u1072 \u1083 : \'ab\u1071  \u1073 \u1099 \u1083 , \u1101 \u1090 \u1086  \u1082 \u1083 \u1072 \u1089 \u1089 \u1085 \u1086 \'bb. \u1045 \u1089 \u1083 \u1080  \u1042 \u1080 \u1082 \u1072  \u1087 \u1086 \u1088 \u1077 \u1082 \u1086 \u1084 \u1077 \u1085 \u1076 \u1091 \u1077 \u1090  \'97 \u1103  \u1087 \u1086 \u1081 \u1076 \u1091 . \u1069 \u1090 \u1086  \u1074 \u1086 \u1087 \u1088 \u1086 \u1089  \u1076 \u1086 \u1074 \u1077 \u1088 \u1080 \u1103  \u1080  \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 \u1089 \u1090 \u1080 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1044 \u1072 , \u1080  \u1101 \u1090 \u1086  \u1087 \u1086 \u1093 \u1086 \u1078 \u1077  \u1085 \u1072  \u1077 \u1089 \u1090 \u1077 \u1089 \u1090 \u1074 \u1077 \u1085 \u1085 \u1091 \u1102  \'ab\u1092 \u1080 \u1083 \u1100 \u1090 \u1088 \u1072 \u1094 \u1080 \u1102 \'bb \'97 \u1084 \u1099  \u1095 \u1072 \u1089 \u1090 \u1086  \u1074 \u1099 \u1073 \u1080 \u1088 \u1072 \u1077 \u1084  \u1087 \u1086  \u1088 \u1077 \u1082 \u1086 \u1084 \u1077 \u1085 \u1076 \u1072 \u1094 \u1080 \u1080  \u1076 \u1088 \u1091 \u1079 \u1077 \u1081  \u1089  \u1087 \u1086 \u1093 \u1086 \u1078 \u1080 \u1084 \u1080  \u1094 \u1077 \u1085 \u1085 \u1086 \u1089 \u1090 \u1103 \u1084 \u1080 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1048 \u1084 \u1077 \u1085 \u1085 \u1086 . \u1045 \u1089 \u1083 \u1080  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1086 \u1084 \u1091  \u1103  \u1076 \u1086 \u1074 \u1077 \u1088 \u1103 \u1102 , \u1079 \u1086 \u1074 \u1105 \u1090  \'97 \u1079 \u1085 \u1072 \u1095 \u1080 \u1090 , \u1090 \u1072 \u1084  \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 . \u1044 \u1072 \u1078 \u1077  \u1077 \u1089 \u1083 \u1080  \u1085 \u1077  \u1076 \u1086  \u1082 \u1086 \u1085 \u1094 \u1072  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1102 , \u1095 \u1090 \u1086  \u1101 \u1090 \u1086 , \'97 \u1087 \u1086 \u1081 \u1076 \u1091 . \u1040  \u1077 \u1089 \u1083 \u1080  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1088 \u1077 \u1082 \u1083 \u1072 \u1084 \u1072  \u1080  \'ab\u1101 \u1079 \u1086 \u1090 \u1077 \u1088 \u1080 \u1082 \u1072 \'bb, \u1075 \u1076 \u1077  \u1086 \u1073 \u1077 \u1097 \u1072 \u1102 \u1090  \'ab\u1089 \u1088 \u1072 \u1079 \u1091  \u1087 \u1088 \u1086 \u1089 \u1085 \u1105 \u1090 \u1077 \u1089 \u1100  \u1085 \u1086 \u1074 \u1099 \u1084  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082 \u1086 \u1084 \'bb \'97 \u1085 \u1077 \u1090 , \u1089 \u1087 \u1072 \u1089 \u1080 \u1073 \u1086 .\
\uc0\u1052 \u1085 \u1077  \u1088 \u1077 \u1078 \u1077 \u1090  \u1089 \u1083 \u1091 \u1093  \u1089 \u1083 \u1086 \u1074 \u1086  \'ab\u1073 \u1077 \u1089 \u1087 \u1083 \u1072 \u1090 \u1085 \u1086 \'bb. \u1055 \u1091 \u1089 \u1090 \u1100  \u1073 \u1091 \u1076 \u1077 \u1090  \'ab\u1086 \u1079 \u1085 \u1072 \u1082 \u1086 \u1084 \u1080 \u1090 \u1077 \u1083 \u1100 \u1085 \u1072 \u1103  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 \'bb \'97 \u1101 \u1090 \u1086  \u1076 \u1088 \u1091 \u1075 \u1086 \u1077 . \u1048  \u1074 \u1072 \u1078 \u1085 \u1086 , \u1075 \u1076 \u1077  \u1087 \u1088 \u1086 \u1093 \u1086 \u1076 \u1080 \u1090 : \u1077 \u1089 \u1083 \u1080  \u1086 \u1092 \u1083 \u1072 \u1081 \u1085  \'97 \u1087 \u1091 \u1089 \u1090 \u1100  \u1101 \u1090 \u1086  \u1073 \u1091 \u1076 \u1077 \u1090  \u1089 \u1087 \u1086 \u1082 \u1086 \u1081 \u1085 \u1086 \u1077  \u1084 \u1077 \u1089 \u1090 \u1086  \u1074 \u1088 \u1086 \u1076 \u1077  \u1079 \u1072 \u1083 \u1072  \u1076 \u1083 \u1103  \u1081 \u1086 \u1075 \u1080 , \u1072  \u1085 \u1077  \u1089 \u1083 \u1091 \u1095 \u1072 \u1081 \u1085 \u1099 \u1081  Zoom.\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1040  \u1095 \u1090 \u1086  \u1074  \u1090 \u1072 \u1082 \u1086 \u1084  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 \u1077  \u1090 \u1077 \u1073 \u1103  \u1085 \u1072 \u1089 \u1090 \u1086 \u1088 \u1086 \u1078 \u1080 \u1090 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1051 \u1102 \u1073 \u1099 \u1077  \u1086 \u1073 \u1077 \u1097 \u1072 \u1085 \u1080 \u1103  \u1084 \u1075 \u1085 \u1086 \u1074 \u1077 \u1085 \u1085 \u1086 \u1075 \u1086  \u1088 \u1077 \u1079 \u1091 \u1083 \u1100 \u1090 \u1072 \u1090 \u1072 : \'ab\u1089 \u1088 \u1072 \u1079 \u1091  \u1080 \u1079 \u1073 \u1072 \u1074 \u1080 \u1096 \u1100 \u1089 \u1103  \u1086 \u1090  \u1090 \u1088 \u1077 \u1074 \u1086 \u1075 \u1080 \'bb, \'ab\u1089 \u1088 \u1072 \u1079 \u1091  \u1089 \u1090 \u1072 \u1085 \u1077 \u1096 \u1100  \u1073 \u1086 \u1075 \u1072 \u1090 \u1086 \u1081 \'bb. \u1069 \u1090 \u1086  \u1085 \u1077 \u1087 \u1088 \u1072 \u1074 \u1076 \u1072 . \u1053 \u1072  \u1074 \u1089 \u1105  \u1085 \u1091 \u1078 \u1085 \u1086  \u1074 \u1088 \u1077 \u1084 \u1103  \u1080  \u1089 \u1080 \u1089 \u1090 \u1077 \u1084 \u1085 \u1086 \u1089 \u1090 \u1100 . \u1041 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 \u1089 \u1090 \u1100 , \u1076 \u1086 \u1074 \u1077 \u1088 \u1080 \u1077  \u1080  \u1088 \u1077 \u1072 \u1083 \u1080 \u1089 \u1090 \u1080 \u1095 \u1085 \u1086 \u1089 \u1090 \u1100  \'97 \u1075 \u1083 \u1072 \u1074 \u1085 \u1086 \u1077 . \u1048  \u1095 \u1090 \u1086 \u1073 \u1099  \u1074 \u1077 \u1076 \u1091 \u1097 \u1080 \u1081  \u1085 \u1077  \'ab\u1091 \u1083 \u1077 \u1090 \u1072 \u1083  \u1074  \u1101 \u1079 \u1086 \u1090 \u1077 \u1088 \u1080 \u1082 \u1091 \'bb, \u1072  \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1083  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1095 \u1077 \u1089 \u1082 \u1080 \u1084  \u1103 \u1079 \u1099 \u1082 \u1086 \u1084 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1040  \u1082 \u1086 \u1084 \u1100 \u1102 \u1085 \u1080 \u1090 \u1080 ? \u1053 \u1072 \u1089 \u1082 \u1086 \u1083 \u1100 \u1082 \u1086  \u1074 \u1072 \u1078 \u1085 \u1099  \u1083 \u1102 \u1076 \u1080  \u1074 \u1086 \u1082 \u1088 \u1091 \u1075 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1054 \u1095 \u1077 \u1085 \u1100 . \u1054 \u1089 \u1086 \u1073 \u1077 \u1085 \u1085 \u1086  \u1074  \u1078 \u1077 \u1085 \u1089 \u1082 \u1080 \u1093  \u1089 \u1086 \u1086 \u1073 \u1097 \u1077 \u1089 \u1090 \u1074 \u1072 \u1093 . \u1057 \u1077 \u1081 \u1095 \u1072 \u1089  \u1103  \u1095 \u1091 \u1074 \u1089 \u1090 \u1074 \u1091 \u1102 , \u1082 \u1072 \u1082  \u1084 \u1099  \u1088 \u1077 \u1072 \u1083 \u1100 \u1085 \u1086  \u1087 \u1086 \u1084 \u1086 \u1075 \u1072 \u1077 \u1084  \u1076 \u1088 \u1091 \u1075  \u1076 \u1088 \u1091 \u1075 \u1091 . \u1059  \u1084 \u1091 \u1078 \u1095 \u1080 \u1085  \u1090 \u1072 \u1082 \u1086 \u1075 \u1086  \u1085 \u1077 \u1090 . \u1050 \u1086 \u1075 \u1076 \u1072  \u1089 \u1083 \u1099 \u1096 \u1080 \u1096 \u1100  \u1080 \u1089 \u1090 \u1086 \u1088 \u1080 \u1080  \u1076 \u1088 \u1091 \u1075 \u1080 \u1093  \u1078 \u1077 \u1085 \u1097 \u1080 \u1085  \'97 \u1086 \u1089 \u1086 \u1079 \u1085 \u1072 \u1105 \u1096 \u1100 , \u1095 \u1090 \u1086  \u1085 \u1077  \u1086 \u1076 \u1085 \u1072 , \u1080  \u1101 \u1090 \u1086  \u1091 \u1078 \u1077  \u1083 \u1077 \u1095 \u1080 \u1090 .\
\uc0\u1061 \u1086 \u1095 \u1077 \u1090 \u1089 \u1103 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1076 \u1077 \u1074 \u1095 \u1086 \u1085 \u1082 \u1080  \u1085 \u1077  \u1085 \u1072 \u1089 \u1090 \u1091 \u1087 \u1072 \u1083 \u1080  \u1085 \u1072  \u1090 \u1077  \u1078 \u1077  \u1075 \u1088 \u1072 \u1073 \u1083 \u1080 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1079 \u1085 \u1072 \u1083 \u1080 , \u1082 \u1072 \u1082  \u1087 \u1086 \u1084 \u1086 \u1075 \u1072 \u1090 \u1100  \u1089 \u1077 \u1073 \u1077 . \u1052 \u1099  \u1074 \u1077 \u1088 \u1080 \u1084  \u1083 \u1102 \u1076 \u1103 \u1084 , \u1080  \u1080 \u1084 \u1077 \u1085 \u1085 \u1086  \u1087 \u1086 \u1101 \u1090 \u1086 \u1084 \u1091  \u1087 \u1086 \u1087 \u1072 \u1076 \u1072 \u1077 \u1084  \u1074  \u1073 \u1086 \u1083 \u1100 . \u1042 \u1072 \u1078 \u1085 \u1086  \u1089 \u1086 \u1079 \u1076 \u1072 \u1074 \u1072 \u1090 \u1100  \u1089 \u1088 \u1077 \u1076 \u1091 , \u1075 \u1076 \u1077  \u1084 \u1086 \u1078 \u1085 \u1086  \u1076 \u1077 \u1083 \u1080 \u1090 \u1100 \u1089 \u1103  \u1073 \u1077 \u1079  \u1089 \u1090 \u1099 \u1076 \u1072  \u1080  \u1087 \u1086 \u1076 \u1076 \u1077 \u1088 \u1078 \u1080 \u1074 \u1072 \u1090 \u1100  \u1076 \u1088 \u1091 \u1075  \u1076 \u1088 \u1091 \u1075 \u1072 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1044 \u1072 , \u1101 \u1090 \u1086  \u1080  \u1077 \u1089 \u1090 \u1100  \u1086 \u1087 \u1086 \u1088 \u1072  \'97 \u1074 \u1085 \u1091 \u1090 \u1088 \u1077 \u1085 \u1085 \u1103 \u1103  \u1080  \u1074 \u1085 \u1077 \u1096 \u1085 \u1103 \u1103 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1044 \u1072 . \u1056 \u1072 \u1079 \u1074 \u1080 \u1074 \u1072 \u1090 \u1100  \u1074 \u1085 \u1091 \u1090 \u1088 \u1077 \u1085 \u1085 \u1102 \u1102  \u1086 \u1087 \u1086 \u1088 \u1091  \'97 \u1089 \u1072 \u1084 \u1086 \u1077  \u1074 \u1072 \u1078 \u1085 \u1086 \u1077 . \u1042 \u1089 \u1105  \u1086 \u1089 \u1090 \u1072 \u1083 \u1100 \u1085 \u1086 \u1077  \u1087 \u1088 \u1080 \u1093 \u1086 \u1076 \u1080 \u1090  \u1089 \u1072 \u1084 \u1086 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1052 \u1085 \u1077  \u1073 \u1099 \u1083 \u1086  \u1086 \u1095 \u1077 \u1085 \u1100  \u1080 \u1085 \u1090 \u1077 \u1088 \u1077 \u1089 \u1085 \u1086 . \u1071  \u1087 \u1088 \u1072 \u1074 \u1076 \u1072  \u1078 \u1076 \u1091 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1090 \u1099  \u1074 \u1077 \u1088 \u1085 \u1105 \u1096 \u1100 \u1089 \u1103  \u1074  \u1043 \u1088 \u1091 \u1079 \u1080 \u1102  \u1080  \u1087 \u1088 \u1080 \u1077 \u1076 \u1077 \u1096 \u1100  \u1082  \u1085 \u1072 \u1084  \u1074  \u1075 \u1086 \u1089 \u1090 \u1080 .\
\uc0\u1056 \u1072 \u1079 \u1075 \u1086 \u1074 \u1086 \u1088  \u1087 \u1086 \u1083 \u1091 \u1095 \u1080 \u1083 \u1089 \u1103  \u1075 \u1083 \u1091 \u1073 \u1086 \u1082 \u1080 \u1084 , \u1074 \u1086  \u1084 \u1085 \u1086 \u1075 \u1086 \u1084  \u1090 \u1099  \u1086 \u1090 \u1074 \u1077 \u1090 \u1080 \u1083 \u1072  \u1085 \u1072  \u1074 \u1086 \u1087 \u1088 \u1086 \u1089 \u1099 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1077  \u1091  \u1085 \u1072 \u1089  \u1073 \u1099 \u1083 \u1080  \u1086  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 \u1077 .\
\uc0\u1057 \u1087 \u1072 \u1089 \u1080 \u1073 \u1086  \u1090 \u1077 \u1073 \u1077  \u1086 \u1075 \u1088 \u1086 \u1084 \u1085 \u1086 \u1077 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1044 \u1072 , \u1089 \u1087 \u1072 \u1089 \u1080 \u1073 \u1086 ! \u1054 \u1095 \u1077 \u1085 \u1100  \u1094 \u1077 \u1085 \u1085 \u1086  \u1074 \u1089 \u1105 , \u1095 \u1077 \u1084  \u1090 \u1099  \u1087 \u1086 \u1076 \u1077 \u1083 \u1080 \u1083 \u1072 \u1089 \u1100  \'97 \u1080  \u1089 \u1074 \u1086 \u1081  \u1086 \u1087 \u1099 \u1090 , \u1080  \u1074 \u1079 \u1075 \u1083 \u1103 \u1076  \u1089 \u1086  \u1089 \u1090 \u1086 \u1088 \u1086 \u1085 \u1099 .\
\uc0\u1058 \u1099  \u1087 \u1086 \u1084 \u1086 \u1075 \u1083 \u1072  \u1085 \u1072 \u1084  \u1091 \u1074 \u1080 \u1076 \u1077 \u1090 \u1100  \u1084 \u1085 \u1086 \u1075 \u1086 \u1077  \u1087 \u1086 \u1076  \u1076 \u1088 \u1091 \u1075 \u1080 \u1084  \u1091 \u1075 \u1083 \u1086 \u1084 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1052 \u1085 \u1077  \u1090 \u1086 \u1078 \u1077  \u1073 \u1099 \u1083 \u1086  \u1087 \u1088 \u1080 \u1103 \u1090 \u1085 \u1086 . \u1071  \u1093 \u1086 \u1095 \u1091  \u1087 \u1086 \u1084 \u1086 \u1095 \u1100 , \u1087 \u1088 \u1072 \u1074 \u1076 \u1072 .\
(\uc0\u1089 \u1084 \u1077 \u1105 \u1090 \u1089 \u1103 ) \u1052 \u1086 \u1078 \u1085 \u1086  \u1103  \u1088 \u1072 \u1089 \u1089 \u1095 \u1080 \u1090 \u1099 \u1074 \u1072 \u1102  \u1085 \u1072  \u1087 \u1088 \u1086 \u1094 \u1077 \u1085 \u1090  \u1089  \u1074 \u1072 \u1096 \u1077 \u1075 \u1086  \u1087 \u1088 \u1086 \u1077 \u1082 \u1090 \u1072 ?\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1050 \u1086 \u1085 \u1077 \u1095 \u1085 \u1086 ! \u1045 \u1089 \u1083 \u1080  \u1087 \u1088 \u1086 \u1074 \u1077 \u1076 \u1105 \u1096 \u1100  \u1093 \u1086 \u1083 \u1086 \u1090 \u1088 \u1086 \u1087  \u1085 \u1072  \u1092 \u1077 \u1089 \u1090 \u1080 \u1074 \u1072 \u1083 \u1077  \u1085 \u1072  \u1089 \u1090 \u1086  \u1090 \u1099 \u1089 \u1103 \u1095  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082  \'97 \u1090 \u1086 \u1095 \u1085 \u1086  \u1076 \u1072 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  (\uc0\u1089 \u1084 \u1077 \u1105 \u1090 \u1089 \u1103 ) \u1052 \u1099 , \u1082 \u1089 \u1090 \u1072 \u1090 \u1080 , \u1087 \u1086 \u1095 \u1090 \u1080  \u1085 \u1077  \u1096 \u1083 \u1080  \u1087 \u1086  \u1089 \u1087 \u1080 \u1089 \u1082 \u1091  \u1074 \u1086 \u1087 \u1088 \u1086 \u1089 \u1086 \u1074 , \u1085 \u1086  \u1079 \u1072 \u1090 \u1086  \u1087 \u1086 \u1083 \u1091 \u1095 \u1080 \u1083 \u1086 \u1089 \u1100  \u1078 \u1080 \u1074 \u1086  \u1080  \u1086 \u1073 \u1098 \u1105 \u1084 \u1085 \u1086 .\
\uc0\u1053 \u1077  \u1093 \u1086 \u1095 \u1091  \u1089 \u1080 \u1083 \u1100 \u1085 \u1086  \u1079 \u1072 \u1090 \u1103 \u1075 \u1080 \u1074 \u1072 \u1090 \u1100  \u1074 \u1088 \u1077 \u1084 \u1103 , \u1085 \u1086 , \u1084 \u1086 \u1078 \u1077 \u1090 , \u1085 \u1072 \u1087 \u1086 \u1089 \u1083 \u1077 \u1076 \u1086 \u1082  \u1089 \u1087 \u1088 \u1086 \u1096 \u1091 .\
\uc0\u1045 \u1089 \u1083 \u1080  \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1090 \u1100  \u1087 \u1088 \u1086  \u1087 \u1077 \u1088 \u1074 \u1099 \u1081  \u1082 \u1086 \u1085 \u1090 \u1072 \u1082 \u1090  \u1089  \u1085 \u1086 \u1074 \u1099 \u1084  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 \u1086 \u1084  \'97 \u1095 \u1090 \u1086  \u1076 \u1083 \u1103  \u1090 \u1077 \u1073 \u1103  \u1089 \u1076 \u1077 \u1083 \u1072 \u1077 \u1090  \u1077 \u1075 \u1086  \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1099 \u1084  \u1080  \u1074 \u1099 \u1079 \u1099 \u1074 \u1072 \u1102 \u1097 \u1080 \u1084  \u1076 \u1086 \u1074 \u1077 \u1088 \u1080 \u1077 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1054 \u1090 \u1089 \u1091 \u1090 \u1089 \u1090 \u1074 \u1080 \u1077  \u1089 \u1083 \u1086 \u1074 \u1072  \'ab\u1073 \u1077 \u1089 \u1087 \u1083 \u1072 \u1090 \u1085 \u1086 \'bb \'97 \u1087 \u1091 \u1089 \u1090 \u1100  \u1073 \u1091 \u1076 \u1077 \u1090  \'ab\u1086 \u1079 \u1085 \u1072 \u1082 \u1086 \u1084 \u1080 \u1090 \u1077 \u1083 \u1100 \u1085 \u1072 \u1103  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 \'bb.\
\uc0\u1048  \u1084 \u1077 \u1089 \u1090 \u1086  \u1074 \u1072 \u1078 \u1085 \u1086 : \u1079 \u1072 \u1083  \u1081 \u1086 \u1075 \u1080 , \u1094 \u1077 \u1085 \u1090 \u1088  \u1075 \u1086 \u1088 \u1086 \u1076 \u1072 , \u1085 \u1086 \u1088 \u1084 \u1072 \u1083 \u1100 \u1085 \u1072 \u1103  \u1072 \u1090 \u1084 \u1086 \u1089 \u1092 \u1077 \u1088 \u1072 . \u1042  \u1085 \u1072 \u1095 \u1072 \u1083 \u1077  \'97 \u1085 \u1077 \u1073 \u1086 \u1083 \u1100 \u1096 \u1086 \u1081  \u1088 \u1072 \u1079 \u1075 \u1086 \u1074 \u1086 \u1088  \u1089  \u1074 \u1077 \u1076 \u1091 \u1097 \u1080 \u1084 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1087 \u1086 \u1085 \u1103 \u1090 \u1100 , \u1082 \u1090 \u1086  \u1086 \u1085 .\
\uc0\u1071  \u1086 \u1095 \u1077 \u1085 \u1100  \u1086 \u1088 \u1080 \u1077 \u1085 \u1090 \u1080 \u1088 \u1086 \u1074 \u1072 \u1085 \u1072  \u1085 \u1072  \u1083 \u1102 \u1076 \u1077 \u1081 : \u1089 \u1084 \u1086 \u1090 \u1088 \u1102 , \u1082 \u1090 \u1086  \u1089 \u1086 \u1073 \u1088 \u1072 \u1083 \u1089 \u1103 , \u1082 \u1072 \u1082 \u1072 \u1103  \u1101 \u1085 \u1077 \u1088 \u1075 \u1077 \u1090 \u1080 \u1082 \u1072 , \u1082 \u1072 \u1082 \u1080 \u1077  \u1083 \u1080 \u1094 \u1072 .\
\uc0\u1055 \u1086  \u1091 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 \u1072 \u1084  \u1084 \u1086 \u1078 \u1085 \u1086  \u1087 \u1086 \u1085 \u1103 \u1090 \u1100  \u1084 \u1085 \u1086 \u1075 \u1086 \u1077  \u1086  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 \u1077  \'97 \u1077 \u1089 \u1083 \u1080  \u1072 \u1091 \u1076 \u1080 \u1090 \u1086 \u1088 \u1080 \u1103  \u1084 \u1085 \u1077  \u1073 \u1083 \u1080 \u1079 \u1082 \u1072 , \u1103  \u1095 \u1091 \u1074 \u1089 \u1090 \u1074 \u1091 \u1102  \u1089 \u1077 \u1073 \u1103  \u1089 \u1087 \u1086 \u1082 \u1086 \u1081 \u1085 \u1086 .\
\uc0\u1048  \u1086 \u1085 \u1083 \u1072 \u1081 \u1085  \u1090 \u1086  \u1078 \u1077  \u1089 \u1072 \u1084 \u1086 \u1077 : \u1077 \u1089 \u1083 \u1080  \u1074  \u1095 \u1072 \u1090 \u1077  \u1084 \u1085 \u1086 \u1075 \u1086  \u1089 \u1090 \u1088 \u1072 \u1085 \u1085 \u1099 \u1093  \u1083 \u1102 \u1076 \u1077 \u1081 , \u1085 \u1077  \u1079 \u1072 \u1093 \u1086 \u1095 \u1077 \u1090 \u1089 \u1103  \u1074 \u1086 \u1079 \u1074 \u1088 \u1072 \u1097 \u1072 \u1090 \u1100 \u1089 \u1103 .\
\uc0\u1050 \u1086 \u1084 \u1100 \u1102 \u1085 \u1080 \u1090 \u1080  \u1080  \u1082 \u1086 \u1085 \u1090 \u1080 \u1085 \u1075 \u1077 \u1085 \u1090  \u1089 \u1080 \u1083 \u1100 \u1085 \u1086  \u1074 \u1083 \u1080 \u1103 \u1102 \u1090  \u1085 \u1072  \u1076 \u1086 \u1074 \u1077 \u1088 \u1080 \u1077 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1044 \u1072 , \u1103  \u1090 \u1086 \u1078 \u1077  \u1090 \u1072 \u1082  \u1086 \u1094 \u1077 \u1085 \u1080 \u1074 \u1072 \u1102  \'97 \u1085 \u1086  \u1088 \u1072 \u1085 \u1100 \u1096 \u1077  \u1076 \u1072 \u1078 \u1077  \u1085 \u1077  \u1086 \u1089 \u1086 \u1079 \u1085 \u1072 \u1074 \u1072 \u1083 \u1072  \u1101 \u1090 \u1086  \u1082 \u1072 \u1082  \u1082 \u1088 \u1080 \u1090 \u1077 \u1088 \u1080 \u1081 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1042 \u1086 \u1090 , \u1076 \u1072 . \u1052 \u1099  \u1074 \u1089 \u1077  \u1089 \u1091 \u1073 \u1098 \u1077 \u1082 \u1090 \u1080 \u1074 \u1085 \u1099 . \u1055 \u1088 \u1086 \u1089 \u1090 \u1086  \u1074 \u1072 \u1078 \u1085 \u1086  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1090 \u1100 , \u1082 \u1090 \u1086  \u1074 \u1086 \u1082 \u1088 \u1091 \u1075 , \u1089  \u1082 \u1077 \u1084  \u1090 \u1099  \u1076 \u1099 \u1096 \u1080 \u1096 \u1100 .\
\uc0\u1054 \u1090  \u1101 \u1090 \u1086 \u1075 \u1086  \u1088 \u1086 \u1078 \u1076 \u1072 \u1077 \u1090 \u1089 \u1103  \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 \u1089 \u1090 \u1100  \u1080  \u1078 \u1077 \u1083 \u1072 \u1085 \u1080 \u1077  \u1087 \u1088 \u1086 \u1076 \u1086 \u1083 \u1078 \u1072 \u1090 \u1100 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1057 \u1087 \u1072 \u1089 \u1080 \u1073 \u1086  \u1090 \u1077 \u1073 \u1077  \u1073 \u1086 \u1083 \u1100 \u1096 \u1086 \u1077  \u1079 \u1072  \u1090 \u1072 \u1082 \u1091 \u1102  \u1075 \u1083 \u1091 \u1073 \u1080 \u1085 \u1091 .\
\uc0\u1058 \u1099  \u1087 \u1086 \u1084 \u1086 \u1075 \u1083 \u1072  \u1085 \u1077  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1087 \u1088 \u1086 \u1074 \u1077 \u1088 \u1080 \u1090 \u1100  \u1075 \u1080 \u1087 \u1086 \u1090 \u1077 \u1079 \u1099 , \u1085 \u1086  \u1080  \u1085 \u1072 \u1087 \u1086 \u1083 \u1085 \u1080 \u1090 \u1100  \u1087 \u1088 \u1086 \u1077 \u1082 \u1090  \u1089 \u1084 \u1099 \u1089 \u1083 \u1086 \u1084 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1052 \u1099  \u1089 \u1077 \u1081 \u1095 \u1072 \u1089  \u1089 \u1086 \u1073 \u1080 \u1088 \u1072 \u1077 \u1084  \u1084 \u1085 \u1077 \u1085 \u1080 \u1103  \u1080  \u1083 \u1080 \u1095 \u1085 \u1099 \u1077  \u1080 \u1089 \u1090 \u1086 \u1088 \u1080 \u1080 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1076 \u1086 \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1090 \u1100  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 .\
\uc0\u1055 \u1086 \u1090 \u1086 \u1084  \u1089 \u1076 \u1077 \u1083 \u1072 \u1077 \u1084  \u1087 \u1088 \u1077 \u1079 \u1077 \u1085 \u1090 \u1072 \u1094 \u1080 \u1102  \'97 \u1086 \u1073 \u1103 \u1079 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1086  \u1090 \u1077 \u1073 \u1077  \u1087 \u1086 \u1082 \u1072 \u1078 \u1077 \u1084 . \u1048  \u1093 \u1086 \u1090 \u1080 \u1084  \u1087 \u1086 \u1076 \u1072 \u1088 \u1080 \u1090 \u1100  \u1086 \u1076 \u1085 \u1091  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1091 , \u1082 \u1086 \u1088 \u1086 \u1090 \u1082 \u1091 \u1102 , \u1085 \u1072  \u1072 \u1085 \u1075 \u1083 \u1080 \u1081 \u1089 \u1082 \u1086 \u1084 . \u1055 \u1088 \u1086 \u1089 \u1090 \u1086  \u1074  \u1079 \u1085 \u1072 \u1082  \u1073 \u1083 \u1072 \u1075 \u1086 \u1076 \u1072 \u1088 \u1085 \u1086 \u1089 \u1090 \u1080 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1057 \u1087 \u1072 \u1089 \u1080 \u1073 \u1086 , \u1089  \u1091 \u1076 \u1086 \u1074 \u1086 \u1083 \u1100 \u1089 \u1090 \u1074 \u1080 \u1077 \u1084  \u1087 \u1086 \u1089 \u1083 \u1091 \u1096 \u1072 \u1102 .\
\uc0\u1071  \u1074 \u1086 \u1086 \u1073 \u1097 \u1077  \u1088 \u1072 \u1076 \u1072 , \u1095 \u1090 \u1086  \u1074 \u1099  \u1076 \u1077 \u1083 \u1072 \u1077 \u1090 \u1077  \u1090 \u1072 \u1082 \u1091 \u1102  \u1074 \u1077 \u1097 \u1100 . \u1069 \u1090 \u1086  \u1085 \u1091 \u1078 \u1085 \u1086 .\
\uc0\u1061 \u1086 \u1088 \u1086 \u1096 \u1072 \u1103  \u1090 \u1077 \u1084 \u1072  \'97 \u1086 \u1089 \u1086 \u1073 \u1077 \u1085 \u1085 \u1086  \u1087 \u1088 \u1086  \u1078 \u1077 \u1085 \u1089 \u1082 \u1080 \u1077  \u1089 \u1086 \u1086 \u1073 \u1097 \u1077 \u1089 \u1090 \u1074 \u1072 : \u1084 \u1099  \u1087 \u1088 \u1072 \u1074 \u1076 \u1072  \u1084 \u1086 \u1078 \u1077 \u1084  \u1087 \u1086 \u1076 \u1076 \u1077 \u1088 \u1078 \u1080 \u1074 \u1072 \u1090 \u1100  \u1076 \u1088 \u1091 \u1075  \u1076 \u1088 \u1091 \u1075 \u1072 .\
\uc0\u1052 \u1091 \u1078 \u1095 \u1080 \u1085 \u1099  \u1085 \u1077  \u1091 \u1084 \u1077 \u1102 \u1090  \u1090 \u1072 \u1082 , \u1072  \u1085 \u1072 \u1084  \u1074 \u1072 \u1078 \u1085 \u1086  \u1076 \u1077 \u1083 \u1080 \u1090 \u1100 \u1089 \u1103 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1082 \u1072 \u1078 \u1076 \u1072 \u1103  \u1079 \u1085 \u1072 \u1083 \u1072  \'97 \u1086 \u1085 \u1072  \u1085 \u1077  \u1086 \u1076 \u1085 \u1072 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1044 \u1072 , \u1101 \u1090 \u1086  \u1086 \u1095 \u1077 \u1085 \u1100  \u1086 \u1090 \u1082 \u1083 \u1080 \u1082 \u1072 \u1077 \u1090 \u1089 \u1103 .\
\uc0\u1050 \u1086 \u1075 \u1076 \u1072  \u1084 \u1099  \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1084  \u1086 \u1073  \u1101 \u1090 \u1086 \u1084  \u1074 \u1089 \u1083 \u1091 \u1093  \'97 \u1091 \u1078 \u1077  \u1080 \u1089 \u1094 \u1077 \u1083 \u1103 \u1077 \u1084 \u1089 \u1103 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1058 \u1086 \u1095 \u1085 \u1086 . \u1057 \u1090 \u1099 \u1076  \'97 \u1075 \u1083 \u1072 \u1074 \u1085 \u1099 \u1081  \u1073 \u1072 \u1088 \u1100 \u1077 \u1088 . \u1052 \u1085 \u1086 \u1075 \u1080 \u1077  \u1076 \u1091 \u1084 \u1072 \u1102 \u1090 : \'ab\u1071  \u1076 \u1091 \u1088 \u1072 , \u1082 \u1072 \u1082  \u1103  \u1084 \u1086 \u1075 \u1083 \u1072 \'bb, \'97 \u1080  \u1076 \u1072 \u1078 \u1077  \u1089 \u1077 \u1073 \u1077  \u1073 \u1086 \u1103 \u1090 \u1089 \u1103  \u1087 \u1088 \u1080 \u1079 \u1085 \u1072 \u1090 \u1100 \u1089 \u1103 .\
\uc0\u1040  \u1082 \u1086 \u1075 \u1076 \u1072  \u1089 \u1083 \u1099 \u1096 \u1080 \u1096 \u1100 , \u1095 \u1090 \u1086  \u1091  \u1076 \u1088 \u1091 \u1075 \u1080 \u1093  \u1087 \u1086 \u1093 \u1086 \u1078 \u1080 \u1077  \u1080 \u1089 \u1090 \u1086 \u1088 \u1080 \u1080 , \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1077 \u1096 \u1100 : \u1101 \u1090 \u1086  \u1085 \u1077  \u1075 \u1083 \u1091 \u1087 \u1086 \u1089 \u1090 \u1100 , \u1101 \u1090 \u1086  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1074 \u1077 \u1088 \u1072  \u1074  \u1083 \u1102 \u1076 \u1077 \u1081 .\
\uc0\u1048  \u1074  \u1101 \u1090 \u1086 \u1084  \u1077 \u1089 \u1090 \u1100  \u1089 \u1080 \u1083 \u1072 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1040 \u1073 \u1089 \u1086 \u1083 \u1102 \u1090 \u1085 \u1086 .\
\uc0\u1057 \u1087 \u1072 \u1089 \u1080 \u1073 \u1086  \u1090 \u1077 \u1073 \u1077 , \u1051 \u1077 \u1088 \u1072 , \u1079 \u1072  \u1090 \u1074 \u1086 \u1102  \u1095 \u1077 \u1089 \u1090 \u1085 \u1086 \u1089 \u1090 \u1100 , \u1090 \u1077 \u1087 \u1083 \u1086  \u1080  \u1075 \u1083 \u1091 \u1073 \u1080 \u1085 \u1091 .\
\uc0\u1052 \u1099  \u1088 \u1077 \u1072 \u1083 \u1100 \u1085 \u1086  \u1087 \u1086 \u1095 \u1091 \u1074 \u1089 \u1090 \u1074 \u1086 \u1074 \u1072 \u1083 \u1080 , \u1095 \u1090 \u1086  \u1090 \u1099  \u1089  \u1085 \u1072 \u1084 \u1080 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1048  \u1103  \u1089  \u1074 \u1072 \u1084 \u1080 .\
\uc0\u1054 \u1073 \u1085 \u1080 \u1084 \u1072 \u1102  \u1074 \u1072 \u1089 , \u1076 \u1077 \u1074 \u1086 \u1095 \u1082 \u1080 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1054 \u1073 \u1085 \u1080 \u1084 \u1072 \u1077 \u1084  \u1080  \u1078 \u1076 \u1105 \u1084  \u1074 \u1089 \u1090 \u1088 \u1077 \u1095 \u1080 !\
}