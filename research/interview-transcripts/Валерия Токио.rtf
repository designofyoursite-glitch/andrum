\outl0\strokewidth0 \strokec2 \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1050 \u1086 \u1088 \u1086 \u1095 \u1077 , \u1084 \u1099  \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1077 \u1084  \u1074 \u1090 \u1088 \u1086 \u1105 \u1084 . \u1050 \u1089 \u1102 \u1096 \u1072  \'97 \u1092 \u1072 \u1089 \u1080 \u1083 \u1080 \u1090 \u1072 \u1090 \u1086 \u1088  \u1076 \u1099 \u1093 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1099 \u1093  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 , \u1086 \u1085 \u1072  \u1074 \u1077 \u1076 \u1105 \u1090  \u1089 \u1077 \u1089 \u1089 \u1080 \u1080 . \u1040  \u1084 \u1099  \u1074 \u1090 \u1088 \u1086 \u1105 \u1084  \u1074 \u1084 \u1077 \u1089 \u1090 \u1077  \u1089 \u1086 \u1079 \u1076 \u1072 \u1105 \u1084  \u1101 \u1090 \u1086 \u1090  \u1087 \u1088 \u1086 \u1077 \u1082 \u1090 , \u1091  \u1082 \u1072 \u1078 \u1076 \u1086 \u1081  \u1089 \u1074 \u1086 \u1103  \u1079 \u1072 \u1076 \u1072 \u1095 \u1072 .\
\uc0\u1045 \u1089 \u1083 \u1080  \u1082 \u1086 \u1088 \u1086 \u1090 \u1082 \u1086 , \u1084 \u1099  \u1087 \u1086 \u1085 \u1103 \u1083 \u1080 , \u1095 \u1090 \u1086  \u1086 \u1095 \u1077 \u1085 \u1100  \u1095 \u1072 \u1089 \u1090 \u1086  \u1078 \u1077 \u1085 \u1097 \u1080 \u1085 \u1099  \u1089 \u1090 \u1072 \u1083 \u1082 \u1080 \u1074 \u1072 \u1102 \u1090 \u1089 \u1103  \u1089  \u1089 \u1080 \u1083 \u1100 \u1085 \u1086 \u1081  \u1090 \u1088 \u1077 \u1074 \u1086 \u1078 \u1085 \u1086 \u1089 \u1090 \u1100 \u1102 , \u1086 \u1089 \u1086 \u1073 \u1077 \u1085 \u1085 \u1086  \u1074  \u1086 \u1090 \u1085 \u1086 \u1096 \u1077 \u1085 \u1080 \u1103 \u1093  \'97 \u1087 \u1086 \u1087 \u1072 \u1076 \u1072 \u1102 \u1090  \u1074  \u1074 \u1086 \u1088 \u1086 \u1085 \u1082 \u1091 , \u1080 \u1079  \u1082 \u1086 \u1090 \u1086 \u1088 \u1086 \u1081  \u1082 \u1072 \u1078 \u1077 \u1090 \u1089 \u1103  \u1085 \u1077 \u1074 \u1086 \u1079 \u1084 \u1086 \u1078 \u1085 \u1086  \u1074 \u1099 \u1073 \u1088 \u1072 \u1090 \u1100 \u1089 \u1103 .\
\uc0\u1045 \u1089 \u1090 \u1100  \u1088 \u1072 \u1079 \u1085 \u1099 \u1077  \u1080 \u1085 \u1089 \u1090 \u1088 \u1091 \u1084 \u1077 \u1085 \u1090 \u1099 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1077  \u1084 \u1086 \u1075 \u1091 \u1090  \u1087 \u1086 \u1084 \u1086 \u1095 \u1100 , \u1080  \u1084 \u1099  \u1088 \u1077 \u1096 \u1080 \u1083 \u1080  \u1089 \u1076 \u1077 \u1083 \u1072 \u1090 \u1100  \u1087 \u1088 \u1086 \u1077 \u1082 \u1090  \u1087 \u1086  \u1076 \u1099 \u1093 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1099 \u1084  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 \u1084  \'97 \u1082 \u1072 \u1082  \u1089 \u1087 \u1086 \u1089 \u1086 \u1073  \u1089 \u1087 \u1088 \u1072 \u1074 \u1083 \u1103 \u1090 \u1100 \u1089 \u1103  \u1089  \u1090 \u1072 \u1082 \u1080 \u1084 \u1080  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1103 \u1084 \u1080 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1091 \u1078 \u1077  \u1085 \u1077 \u1074 \u1086 \u1079 \u1084 \u1086 \u1078 \u1085 \u1086  \u1091 \u1087 \u1088 \u1072 \u1074 \u1083 \u1103 \u1090 \u1100  \u1089 \u1086 \u1073 \u1086 \u1081 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1071  \u1085 \u1077 \u1084 \u1085 \u1086 \u1075 \u1086  \u1089 \u1073 \u1080 \u1074 \u1095 \u1080 \u1074 \u1086  \u1075 \u1086 \u1074 \u1086 \u1088 \u1102 , \u1087 \u1086 \u1090 \u1086 \u1084 \u1091  \u1095 \u1090 \u1086  \u1087 \u1077 \u1088 \u1074 \u1099 \u1081  \u1076 \u1077 \u1085 \u1100  \u1087 \u1086 \u1089 \u1083 \u1077  \u1086 \u1090 \u1087 \u1091 \u1089 \u1082 \u1072 , \u1085 \u1072 \u1076 \u1077 \u1102 \u1089 \u1100 , \u1101 \u1090 \u1086  \u1085 \u1077  \u1089 \u1084 \u1091 \u1097 \u1072 \u1077 \u1090 . \u1045 \u1089 \u1083 \u1080  \u1077 \u1089 \u1090 \u1100  \u1074 \u1086 \u1087 \u1088 \u1086 \u1089 \u1099  \u1087 \u1088 \u1086  \u1087 \u1088 \u1086 \u1077 \u1082 \u1090  \'97 \u1084 \u1086 \u1078 \u1077 \u1084  \u1091 \u1075 \u1083 \u1091 \u1073 \u1080 \u1090 \u1100 \u1089 \u1103 , \u1084 \u1086 \u1078 \u1077 \u1084  \u1087 \u1086 \u1076 \u1077 \u1083 \u1080 \u1090 \u1100 \u1089 \u1103 , \u1087 \u1086 \u1095 \u1077 \u1084 \u1091  \u1085 \u1072 \u1089  \u1101 \u1090 \u1086  \u1079 \u1072 \u1078 \u1075 \u1083 \u1086 , \u1080 \u1083 \u1080  \u1089 \u1088 \u1072 \u1079 \u1091  \u1087 \u1077 \u1088 \u1077 \u1081 \u1090 \u1080  \u1082  \u1074 \u1086 \u1087 \u1088 \u1086 \u1089 \u1072 \u1084 . \u1050 \u1072 \u1082  \u1090 \u1077 \u1073 \u1077  \u1091 \u1076 \u1086 \u1073 \u1085 \u1077 \u1077 ?\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1071  \u1093 \u1086 \u1095 \u1091 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1074 \u1099  \u1087 \u1088 \u1077 \u1076 \u1089 \u1090 \u1072 \u1074 \u1080 \u1083 \u1080  \u1052 \u1072 \u1088 \u1080 \u1102 . \u1050 \u1089 \u1102 \u1096 \u1091  \u1090 \u1099  \u1087 \u1088 \u1077 \u1076 \u1089 \u1090 \u1072 \u1074 \u1080 \u1083 \u1072 , \u1072  \u1052 \u1072 \u1088 \u1080 \u1102  \u1085 \u1077 \u1090 , \u1084 \u1085 \u1077  \u1083 \u1102 \u1073 \u1086 \u1087 \u1099 \u1090 \u1085 \u1086 .\

\f0\b \uc0\u1042 \u1080 \u1082 \u1072 :
\f1\b0  \uc0\u1052 \u1072 \u1088 \u1080 \u1103  \u1091  \u1085 \u1072 \u1089  \u1086 \u1090 \u1074 \u1077 \u1095 \u1072 \u1077 \u1090  \u1079 \u1072  \u1082 \u1088 \u1077 \u1072 \u1090 \u1080 \u1074  \u1080  \u1074 \u1085 \u1091 \u1090 \u1088 \u1077 \u1085 \u1085 \u1086 \u1089 \u1090 \u1080  \u1087 \u1088 \u1086 \u1077 \u1082 \u1090 \u1072 , \u1086 \u1085 \u1072  \u1085 \u1072 \u1096  \u1076 \u1074 \u1080 \u1075 \u1072 \u1090 \u1077 \u1083 \u1100  \'97 \u1074 \u1089 \u1105  \u1089 \u1090 \u1088 \u1091 \u1082 \u1090 \u1091 \u1088 \u1080 \u1088 \u1091 \u1077 \u1090  \u1080  \u1086 \u1088 \u1075 \u1072 \u1085 \u1080 \u1079 \u1091 \u1077 \u1090 . \u1057 \u1086 \u1073 \u1089 \u1090 \u1074 \u1077 \u1085 \u1085 \u1086 , \u1101 \u1090 \u1086  \u1073 \u1099 \u1083 \u1072  \u1052 \u1072 \u1096 \u1080 \u1085 \u1072  \u1080 \u1076 \u1077 \u1103  \'97 \u1089 \u1076 \u1077 \u1083 \u1072 \u1090 \u1100  \u1076 \u1099 \u1093 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1099 \u1081  \u1087 \u1088 \u1086 \u1077 \u1082 \u1090 . \u1052 \u1099  \u1074 \u1089 \u1077  \u1074 \u1084 \u1077 \u1089 \u1090 \u1077  \u1087 \u1086 \u1085 \u1103 \u1083 \u1080 , \u1095 \u1090 \u1086  \u1101 \u1090 \u1086  \u1086 \u1090 \u1082 \u1083 \u1080 \u1082 \u1072 \u1077 \u1090 \u1089 \u1103 .\
\uc0\u1050 \u1089 \u1102 \u1096 \u1072  \u1079 \u1072 \u1082 \u1086 \u1085 \u1095 \u1080 \u1083 \u1072  \u1082 \u1091 \u1088 \u1089  \u1092 \u1072 \u1089 \u1080 \u1083 \u1080 \u1090 \u1072 \u1094 \u1080 \u1080 , \u1072  \u1052 \u1072 \u1096 \u1072  \u1079 \u1072 \u1093 \u1086 \u1090 \u1077 \u1083 \u1072  \u1089 \u1076 \u1077 \u1083 \u1072 \u1090 \u1100  \u1086 \u1090 \u1076 \u1077 \u1083 \u1100 \u1085 \u1099 \u1081  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 , \u1080  \u1084 \u1099  \u1086 \u1073 \u1098 \u1077 \u1076 \u1080 \u1085 \u1080 \u1083 \u1080 \u1089 \u1100 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1042 \u1089 \u1105  \u1074 \u1077 \u1088 \u1085 \u1086 .\

\f0\b \uc0\u1052 \u1072 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1044 \u1072 , \u1074 \u1089 \u1105  \u1090 \u1072 \u1082  \u1080  \u1077 \u1089 \u1090 \u1100 . \u1052 \u1085 \u1077  \u1085 \u1077 \u1095 \u1077 \u1075 \u1086  \u1076 \u1086 \u1073 \u1072 \u1074 \u1080 \u1090 \u1100 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1040  \u1074 \u1099  \u1074 \u1089 \u1077  \u1089 \u1077 \u1081 \u1095 \u1072 \u1089  \u1074  \u1043 \u1088 \u1091 \u1079 \u1080 \u1080 ?\

\f0\b \uc0\u1052 \u1072 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1053 \u1077 \u1090 , \u1084 \u1099  \u1074 \u1089 \u1077  \u1074  \u1088 \u1072 \u1079 \u1085 \u1099 \u1093  \u1084 \u1077 \u1089 \u1090 \u1072 \u1093 . \u1071  \'97 \u1074  \u1058 \u1072 \u1080 \u1083 \u1072 \u1085 \u1076 \u1077 , \u1050 \u1089 \u1102 \u1096 \u1072  \'97 \u1074  \u1041 \u1077 \u1083 \u1072 \u1088 \u1091 \u1089 \u1080 , \u1042 \u1080 \u1082 \u1072  \'97 \u1074  \u1043 \u1088 \u1091 \u1079 \u1080 \u1080 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1040  \u1103  \u1074  \u1071 \u1087 \u1086 \u1085 \u1080 \u1080 . \u1052 \u1080 \u1088  \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1089 \u1086 \u1096 \u1105 \u1083 \u1089 \u1103  \u1074  \u1086 \u1076 \u1085 \u1086 \u1081  \u1090 \u1086 \u1095 \u1082 \u1077 .\
\uc0\u1050 \u1083 \u1072 \u1089 \u1089 \u1085 \u1086 , \u1095 \u1090 \u1086  \u1089 \u1077 \u1081 \u1095 \u1072 \u1089  \u1084 \u1086 \u1078 \u1085 \u1086  \u1074 \u1086 \u1090  \u1090 \u1072 \u1082  \u1089 \u1086 \u1077 \u1076 \u1080 \u1085 \u1103 \u1090 \u1100 \u1089 \u1103 .\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1044 \u1072 , \u1073 \u1091 \u1076 \u1090 \u1086  \u1074 \u1089 \u1077  \u1074  \u1086 \u1076 \u1085 \u1086 \u1081  \u1082 \u1086 \u1084 \u1085 \u1072 \u1090 \u1077  \u1086 \u1073 \u1089 \u1091 \u1078 \u1076 \u1072 \u1077 \u1084  \u1074 \u1072 \u1078 \u1085 \u1099 \u1077  \u1090 \u1077 \u1084 \u1099 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1040  \u1074 \u1099  \u1085 \u1072  \u1082 \u1072 \u1082 \u1086 \u1081  \u1088 \u1099 \u1085 \u1086 \u1082  \u1086 \u1088 \u1080 \u1077 \u1085 \u1090 \u1080 \u1088 \u1091 \u1077 \u1090 \u1077 \u1089 \u1100  \'97 \u1072 \u1085 \u1075 \u1083 \u1086 \u1103 \u1079 \u1099 \u1095 \u1085 \u1099 \u1081  \u1080 \u1083 \u1080  \u1088 \u1091 \u1089 \u1089 \u1082 \u1086 \u1103 \u1079 \u1099 \u1095 \u1085 \u1099 \u1081 ?\

\f0\b \uc0\u1050 \u1089 \u1102 \u1096 \u1072 :
\f1\b0  \uc0\u1054 \u1089 \u1085 \u1086 \u1074 \u1085 \u1072 \u1103  \u1094 \u1077 \u1083 \u1100  \'97 \u1072 \u1085 \u1075 \u1083 \u1086 \u1103 \u1079 \u1099 \u1095 \u1085 \u1099 \u1081  \u1088 \u1099 \u1085 \u1086 \u1082 : \u1040 \u1084 \u1077 \u1088 \u1080 \u1082 \u1072 , \u1045 \u1074 \u1088 \u1086 \u1087 \u1072 .\
\uc0\u1053 \u1086  \u1087 \u1088 \u1080  \u1101 \u1090 \u1086 \u1084  \u1084 \u1099  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1077 \u1084 , \u1095 \u1090 \u1086  \u1083 \u1102 \u1076 \u1080 , \u1075 \u1086 \u1074 \u1086 \u1088 \u1103 \u1097 \u1080 \u1077  \u1087 \u1086 -\u1088 \u1091 \u1089 \u1089 \u1082 \u1080 , \u1085 \u1086  \u1078 \u1080 \u1074 \u1091 \u1097 \u1080 \u1077  \u1079 \u1072  \u1075 \u1088 \u1072 \u1085 \u1080 \u1094 \u1077 \u1081 , \u1090 \u1086 \u1078 \u1077  \u1084 \u1086 \u1075 \u1091 \u1090  \u1073 \u1099 \u1090 \u1100  \u1085 \u1072 \u1096 \u1077 \u1081  \u1072 \u1091 \u1076 \u1080 \u1090 \u1086 \u1088 \u1080 \u1077 \u1081 . \u1059  \u1074 \u1089 \u1077 \u1093  \u1087 \u1086 \u1093 \u1086 \u1078 \u1080 \u1077  \u1087 \u1077 \u1088 \u1077 \u1078 \u1080 \u1074 \u1072 \u1085 \u1080 \u1103  \u1080  \u1088 \u1077 \u1072 \u1082 \u1094 \u1080 \u1080 . \u1055 \u1086 \u1101 \u1090 \u1086 \u1084 \u1091  \u1084 \u1099  \u1087 \u1088 \u1086 \u1073 \u1091 \u1077 \u1084  \u1088 \u1072 \u1079 \u1085 \u1099 \u1077  \u1085 \u1080 \u1096 \u1080  \u1080  \u1089 \u1084 \u1086 \u1090 \u1088 \u1080 \u1084 , \u1075 \u1076 \u1077  \u1086 \u1090 \u1082 \u1083 \u1080 \u1082  \u1089 \u1080 \u1083 \u1100 \u1085 \u1077 \u1077 .\

\f0\b \uc0\u1042 \u1072 \u1083 \u1077 \u1088 \u1080 \u1103 :
\f1\b0  \uc0\u1061 \u1086 \u1088 \u1086 \u1096 \u1086 , \u1073 \u1091 \u1076 \u1091  \u1088 \u1072 \u1076 \u1072  \u1087 \u1086 \u1084 \u1086 \u1095 \u1100  \u1087 \u1086 \u1076 \u1091 \u1084 \u1072 \u1090 \u1100  \u1074 \u1084 \u1077 \u1089 \u1090 \u1077 .\

