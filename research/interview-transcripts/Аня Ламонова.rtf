\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1094 \u1072 : \u1044 \u1072 . \u1052 \u1085 \u1077  \u1085 \u1088 \u1072 \u1074 \u1080 \u1090 \u1089 \u1103  \u1086 \u1090 \u1084 \u1077 \u1095 \u1072 \u1090 \u1100  \u1087 \u1088 \u1086 \u1075 \u1088 \u1077 \u1089 \u1089  \u1075 \u1072 \u1083 \u1086 \u1095 \u1082 \u1086 \u1081 , \u1076 \u1072 \u1074 \u1072 \u1090 \u1100  \u1086 \u1073 \u1088 \u1072 \u1090 \u1085 \u1091 \u1102  \u1089 \u1074 \u1103 \u1079 \u1100 . \u1041 \u1099 \u1083 \u1086  \u1073 \u1099  \u1082 \u1083 \u1072 \u1089 \u1089 \u1085 \u1086  \u1087 \u1077 \u1088 \u1077 \u1076  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1086 \u1081  \u1074 \u1099 \u1073 \u1088 \u1072 \u1090 \u1100  \u1087 \u1072 \u1088 \u1091  \u1101 \u1084 \u1086 \u1094 \u1080 \u1081 /\u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1081 , \u1072  \u1087 \u1086 \u1089 \u1083 \u1077  \'97 \u1089 \u1085 \u1086 \u1074 \u1072  \u1086 \u1090 \u1084 \u1077 \u1090 \u1080 \u1090 \u1100  \u1080  \u1091 \u1074 \u1080 \u1076 \u1077 \u1090 \u1100  \u1089 \u1076 \u1074 \u1080 \u1075 . \u1051 \u1102 \u1073 \u1083 \u1102  \u1089 \u1084 \u1086 \u1090 \u1088 \u1077 \u1090 \u1100 , \u1095 \u1090 \u1086  \u1076 \u1077 \u1083 \u1072 \u1102 \u1090  \u1076 \u1088 \u1091 \u1079 \u1100 \u1103 : \u1077 \u1089 \u1083 \u1080  \u1087 \u1086 \u1076 \u1088 \u1091 \u1075 \u1072  \u1087 \u1088 \u1086 \u1096 \u1083 \u1072  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1091 , \u1084 \u1085 \u1077  \u1093 \u1086 \u1095 \u1077 \u1090 \u1089 \u1103  \u1087 \u1088 \u1086 \u1081 \u1090 \u1080  \u1077 \u1105  \u1090 \u1086 \u1078 \u1077  \u1080  \u1086 \u1073 \u1089 \u1091 \u1076 \u1080 \u1090 \u1100 . \u1069 \u1090 \u1086  \u1089 \u1080 \u1083 \u1100 \u1085 \u1086  \u1074 \u1086 \u1074 \u1083 \u1077 \u1082 \u1072 \u1077 \u1090 . \u1053 \u1086  \u1074 \u1072 \u1078 \u1085 \u1086  \u1085 \u1077  \u1089 \u1082 \u1072 \u1090 \u1099 \u1074 \u1072 \u1090 \u1100 \u1089 \u1103  \u1074  \'ab\u1087 \u1086 \