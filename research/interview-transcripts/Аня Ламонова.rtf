085 \u1080 \u1084 \u1072 \u1083 \u1072 \u1089 \u1100  \u1089 \u1072 \u1084 \u1072  \u1087 \u1086  YouTube \u1091  \u1086 \u1076 \u1085 \u1086 \u1081  \u1074 \u1077 \u1076 \u1091 \u1097 \u1077 \u1081  \'97 \u1077 \u1105  \u1084 \u1077 \u1076 \u1080 \u1090 \u1072 \u1094 \u1080 \u1080  \u1095 \u1072 \u1089 \u1090 \u1086  \u1087 \u1086 \u1084 \u1086 \u1075 \u1072 \u1102 \u1090 , \u1086 \u1089 \u1086 \u1073 \u1077 \u1085 \u1085 \u1086  \u1074  \u1086 \u1089 \u1090 \u1088 \u1086 \u1084  \u1075 \u1086 \u1088 \u1077 . \u1042  \u1094 \u1077 \u1083 \u1086 \u1084  \'97 \u1073 \u1086 \u1083 \u1100 \u1096 \u1086 \u1081  \u1080 \u1085 \u1090 \u1077 \u1088 \u1077 \u1089 , \u1085 \u1086  \u1085 \u1077  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1102 , \u1082 \u1072 \u1082  \u1074 \u1089 \u1090 \u1088 \u1086 \u1080 \u1090 \u1100  \u1101 \u1090 \u1086  \u1074  \u1088 \u1091 \u1090 \u1080 \u1085 \u1091 : \u1082 \u1086 \u1075 \u1076 \u1072  \u1080 \u1084 \u1077 \u1085 \u1085 \u1086  \u1076 \u1077 \u1083 \u1072 \u1090 \u1100 , \u1082 \u1072 \u1082 \u1086 \u1081  \u1092 \u1086 \u1088 \u1084 \u1072 \u1090 , \u1082 \u1072 \u1082  \u1085 \u1077  \u1073 \u1088 \u1086 \u1089 \u1072 \u1090 \u1100 . \u1045 \u1089 \u1083 \u1080  \u1073 \u1099  \u1087 \u1086 \u1076 \u1088 \u1091 \u1075 \u1072  \u1079 \u1074 \u1072 \u1083 \u1072  \'ab\u1087 \u1086 \u1081 \u1076 \u1105 \u1084  \u1087 \u1086 \u1076 \u1099 \u1096 \u1080 \u1084 \'bb \'97 \u1103  \u1073 \u1099  \u1089 \u1086 \u1075 \u1083 \u1072 \u1096 \u1072 \u1083 \u1072 \u1089 \u1100 .\
\uc0\u1042 \u1077 \u1076 \u1091 \u1097 \u1072 \u1103 : \u1055 \u1088 \u1077 \u1076 \u1089 \u1090 \u1072 \u1074 \u1100  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090  \u1089  \u1082 \u1088 \u1072 \u1090 \u1082 \u1080 \u1084 \u1080  \'abSOS-\u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 \u1084 \u1080 \'bb (2\'9610 \u1084 \u1080 \u1085 \u1091 \u1090 ), \u1077 \u1078 \u1077 \u1076 \u1085 \u1077 \u1074 \u1085 \u1099 \u1084 \u1080  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 \u1084 \u1080  (15\'9620 \u1084 \u1080 \u1085 \u1091 \u1090 ) \u1080  \u1088 \u1077 \u1076 \u1082 \u1080 \u1084 \u1080  \u1095 \u1072 \u1089 \u1086 \u1074 \u1099 \u1084 \u1080  \'ab\u1094 \u1077 \u1088 \u1077 \u1084 \u1086 \u1085 \u1080 \u1103 \u1084 \u1080 \'bb. \u1063 \u1090 \u1086  \u1087 \u1088 \u1080 \u1074 \u1083 \u1077 \u1082 \u1072 \u1077 \u1090 , \u1095 \u1090 \u1086  \u1085 \u1072 \u1089 \u1090 \u1086 \u1088 \u1072 \u1078 \u1080 \u1074 \u1072 \u1077 \u1090 ?\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1094 \u1072 : \u1053 \u1088 \u1072 \u1074 \u1080 \u1090 \u1089 \u1103 , \u1095 \u1090 \u1086  \u1077 \u1089 \u1090 \u1100  \u1088 \u1072 \u1079 \u1085 \u1099 \u1077  \u1092 \u1086 \u1088 \u1084 \u1072 \u1090 \u1099  \'97 \u1091  \u1084 \u1077 \u1085 \u1103  \u1088 \u1072 \u1079 \u1085 \u1099 \u1077  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1103  \u1080  \u1085 \u1072 \u1089 \u1090 \u1088 \u1086 \u1077 \u1085 \u1080 \u1103 . \u1061 \u1086 \u1095 \u1091  \u1080 \u1084 \u1077 \u1090 \u1100  \u1076 \u1086 \u1089 \u1090 \u1091 \u1087  \u1082 \u1086  \u1074 \u1089 \u1077 \u1084 \u1091  \u1089 \u1088 \u1072 \u1079 \u1091  \u1080  \u1089 \u1072 \u1084 \u1086 \u1081  \u1074 \u1099 \u1073 \u1080 \u1088 \u1072 \u1090 \u1100 , \u1095 \u1090 \u1086  \u1074 \u1082 \u1083 \u1102 \u1095 \u1080 \u1090 \u1100 . \u1053 \u1077  \u1083 \u1102 \u1073 \u1083 \u1102 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080  \'ab\u1078 \u1105 \u1089 \u1090 \u1082 \u1086  \u1087 \u1088 \u1080 \u1082 \u1088 \u1091 \u1095 \u1077 \u1085 \u1099 \'bb \u1082  \u1089 \u1094 \u1077 \u1085 \u1072 \u1088 \u1080 \u1102  (\u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1087 \u1077 \u1088 \u1077 \u1076  \u1089 \u1085 \u1086 \u1084 /\u1079 \u1072  \u1088 \u1072 \u1073 \u1086 \u1090 \u1086 \u1081 ). \u1042 \u1072 \u1088 \u1080 \u1072 \u1090 \u1080 \u1074 \u1085 \u1086 \u1089 \u1090 \u1100  \'97 \u1101 \u1090 \u1086  \u1084 \u1086 \u1105 . \u1048  \u1082 \u1083 \u1072 \u1089 \u1089 \u1085 \u1086 , \u1077 \u1089 \u1083 \u1080  \u1084 \u1086 \u1078 \u1085 \u1086  \u1082 \u1086 \u1084 \u1073 \u1080 \u1085 \u1080 \u1088 \u1086 \u1074 \u1072 \u1090 \u1100 : \u1082 \u1086 \u1088 \u1086 \u1090 \u1082 \u1072 \u1103  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072  \u1089 \u1085 \u1080 \u1084 \u1072 \u1077 \u1090  \u1086 \u1089 \u1090 \u1088 \u1086 \u1090 \u1091 , \u1087 \u1086 \u1090 \u1086 \u1084  \'97 \u1076 \u1083 \u1080 \u1085 \u1085 \u1072 \u1103 .\
\uc0\u1042 \u1077 \u1076 \u1091 \u1097 \u1072 \u1103 : \u1058 \u1077 \u1073 \u1077  \u1074 \u1072 \u1078 \u1085 \u1077 \u1077  \u1080 \u1085 \u1089 \u1090 \u1088 \u1091 \u1084 \u1077 \u1085 \u1090  \u1082 \u1072 \u1082  \u1090 \u1072 \u1082 \u1086 \u1074 \u1086 \u1081  \u1080 \u1083 \u1080  \'ab\u1089 \u1083 \u1077 \u1076 \u1086 \u1074 \u1072 \u1090 \u1100  \u1079 \u1072  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082 \u1086 \u1084 -\u1087 \u1088 \u1086 \u1074 \u1086 \u1076 \u1085 \u1080 \u1082 \u1086 \u1084 \'bb?\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1094 \u1072 : \u1054 \u1073 \u1072  \u1074 \u1072 \u1088 \u1080 \u1072 \u1085 \u1090 \u1072 . \u1063 \u1072 \u1089 \u1090 \u1086  \u1090 \u1072 \u1082 : \u1087 \u1088 \u1086 \u1073 \u1091 \u1102  \u1088 \u1072 \u1079 \u1085 \u1099 \u1077  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1080  \'97 \'ab\u1094 \u1077 \u1087 \u1083 \u1103 \u1077 \u1090 \'bb \u1087 \u1086 \u1076 \u1072 \u1095 \u1072  \u1086 \u1076 \u1085 \u1086 \u1075 \u1086  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082 \u1072  \'97 \u1080  \u1076 \u1072 \u1083 \u1100 \u1096 \u1077  \u1093 \u1086 \u1095 \u1091  \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1091  \u1085 \u1077 \u1075 \u1086 . \u1053 \u1086  \u1089 \u1085 \u1072 \u1095 \u1072 \u1083 \u1072  \u1084 \u1085 \u1077  \u1085 \u1091 \u1078 \u1085 \u1086  \u1086 \u1097 \u1091 \u1090 \u1080 \u1090 \u1100  \u1101 \u1090 \u1086  \u1086 \u1087 \u1099 \u1090 \u1086 \u1084 , \u1072  \u1085 \u1077  \u1095 \u1077 \u1088 \u1077 \u1079  \u1087 \u1088 \u1086 \u1092 \u1080 \u1083 \u1100  \u1074  \u1089 \u1086 \u1094 \u1089 \u1077 \u1090 \u1103 \u1093 . \u1048  \u1076 \u1072 , \u1091  \u1084 \u1077 \u1085 \u1103  \u1077 \u1089 \u1090 \u1100  \u1089 \u1090 \u1088 \u1072 \u1093  \u1082 \u1086 \u1084 \u1084 \u1080 \u1090 \u1080 \u1090 \u1100 \u1089 \u1103  \u1085 \u1072  \u1087 \u1083 \u1072 \u1090 \u1085 \u1099 \u1081  \u1076 \u1086 \u1089 \u1090 \u1091 \u1087 , \u1087 \u1086 \u1082 \u1072  \u1085 \u1077  \u1087 \u1086 \u1081 \u1084 \u1091  \'ab\u1084 \u1086 \u1105 /\u1085 \u1077  \u1084 \u1086 \u1105 \'bb.\
\uc0\u1042 \u1077 \u1076 \u1091 \u1097 \u1072 \u1103 : \u1050 \u1072 \u1082 \u1086 \u1081  \u1101 \u1092 \u1092 \u1077 \u1082 \u1090  \u1090 \u1099  \u1078 \u1076 \u1072 \u1083 \u1072  \u1073 \u1099  \u1086 \u1090  \u1087 \u1086 \u1082 \u1091 \u1087 \u1082 \u1080 ?\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1094 \u1072 : \u1055 \u1086 \u1084 \u1086 \u1097 \u1100  \u1074  \u1074 \u1099 \u1089 \u1090 \u1088 \u1072 \u1080 \u1074 \u1072 \u1085 \u1080 \u1080  \u1088 \u1091 \u1090 \u1080 \u1085 \u1099  \'97 \u1085 \u1086  \u1073 \u1077 \u1079  \'ab\u1079 \u1072 \u1076 \u1086 \u1083 \u1073 \u1099 \u1074 \u1072 \u1102 \u1097 \u1080 \u1093 \'bb \u1091 \u1074 \u1077 \u1076 \u1086 \u1084 \u1083 \u1077 \u1085 \u1080 \u1081 . \u1061 \u1086 \u1095 \u1091 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1101 \u1090 \u1086  \u1089 \u1090 \u1072 \u1083 \u1086  \u1077 \u1089 \u1090 \u1077 \u1089 \u1090 \u1074 \u1077 \u1085 \u1085 \u1086 \u1081  \u1095 \u1072 \u1089 \u1090 \u1100 \u1102  \u1078 \u1080 \u1079 \u1085 \u1080 . \u1042 \u1072 \u1078 \u1085 \u1086  \u1086 \u1097 \u1091 \u1097 \u1077 \u1085 \u1080 \u1077  \u1079 \u1072 \u1073 \u1086 \u1090 \u1099  \u1074  \u1076 \u1080 \u1079 \u1072 \u1081 \u1085 \u1077 /\u1079 \u1074 \u1091 \u1082 \u1077 /\u1090 \u1077 \u1082 \u1089 \u1090 \u1072 \u1093  \'97 \u1095 \u1090 \u1086 \u1073 \u1099  \u1073 \u1099 \u1083 \u1086  \u1087 \u1088 \u1080 \u1103 \u1090 \u1085 \u1086  \u1074 \u1086 \u1079 \u1074 \u1088 \u1072 \u1097 \u1072 \u1090 \u1100 \u1089 \u1103 . \u1048  \u1086 \u1097 \u1091 \u1090 \u1080 \u1084 \u1099 \u1081  \u1088 \u1077 \u1079 \u1091 \u1083 \u1100 \u1090 \u1072 \u1090 : \u1073 \u1086 \u1083 \u1100 \u1096 \u1077  \u1074 \u1085 \u1091 \u1090 \u1088 \u1077 \u1085 \u1085 \u1077 \u1081  \u1091 \u1089 \u1090 \u1086 \u1081 \u1095 \u1080 \u1074 \u1086 \u1089 \u1090 \u1080  \u1080  \u1089 \u1087 \u1086 \u1082 \u1086 \u1081 \u1089 \u1090 \u1074 \u1080 \u1103  \'97 \u1095 \u1090 \u1086 \u1073 \u1099  \u1103  \u1087 \u1088 \u1103 \u1084 \u1086  \u1079 \u1072 \u1084 \u1077 \u1095 \u1072 \u1083 \u1072  \u1080 \u1079 \u1084 \u1077 \u1085 \u1077 \u1085 \u1080 \u1103 .\
\uc0\u1042 \u1077 \u1076 \u1091 \u1097 \u1072 \u1103 : \u1041 \u1072 \u1083 \u1072 \u1085 \u1089  \'ab\u1085 \u1072 \u1091 \u1095 \u1085 \u1086 /\u1088 \u1080 \u1090 \u1091 \u1072 \u1083 \u1100 \u1085 \u1086 \'bb \'97 \u1095 \u1090 \u1086  \u1073 \u1083 \u1080 \u1078 \u1077 ?\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1094 \u1072 : \u1048  \u1090 \u1086 , \u1080  \u1076 \u1088 \u1091 \u1075 \u1086 \u1077 . \u1061 \u1086 \u1095 \u1091  \u1087 \u1086 \u1085 \u1103 \u1090 \u1085 \u1099 \u1077  \u1086 \u1073 \u1098 \u1103 \u1089 \u1085 \u1077 \u1085 \u1080 \u1103  (\u1095 \u1090 \u1086  \u1087 \u1088 \u1086 \u1080 \u1089 \u1093 \u1086 \u1076 \u1080 \u1090  \u1089  \u1090 \u1077 \u1083 \u1086 \u1084 , \u1087 \u1086 \u1095 \u1077 \u1084 \u1091  \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 ), \u1101 \u1090 \u1086  \u1087 \u1086 \u1074 \u1099 \u1096 \u1072 \u1077 \u1090  \u1076 \u1086 \u1074 \u1077 \u1088 \u1080 \u1077 . \u1048  \u1087 \u1088 \u1080  \u1101 \u1090 \u1086 \u1084  \u1083 \u1102 \u1073 \u1083 \u1102  \u1083 \u1105 \u1075 \u1082 \u1091 \u1102  \u1088 \u1080 \u1090 \u1091 \u1072 \u1083 \u1100 \u1085 \u1086 \u1089 \u1090 \u1100  \u1085 \u1072  \u1091 \u1088 \u1086 \u1074 \u1085 \u1077  \u1101 \u1089 \u1090 \u1077 \u1090 \u1080 \u1082 \u1080 : \u1074 \u1080 \u1079 \u1091 \u1072 \u1083 \u1100 \u1085 \u1099 \u1077  \u1089 \u1080 \u1084 \u1074 \u1086 \u1083 \u1099 , \'ab\u1087 \u1077 \u1088 \u1077 \u1082 \u1083 \u1102 \u1095 \u1072 \u1102 \u1097 \u1080 \u1077 \'bb \u1076 \u1077 \u1090 \u1072 \u1083 \u1080  \'97 \u1095 \u1090 \u1086 \u1073 \u1099  \u1087 \u1086 \u1084 \u1086 \u1095 \u1100  \u1074 \u1099 \u1081 \u1090 \u1080  \u1080 \u1079  \u1073 \u1099 \u1090 \u1086 \u1074 \u1086 \u1075 \u1086  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1103  \u1074  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1091 . \u1043 \u1083 \u1072 \u1074 \u1085 \u1086 \u1077  \'97 \u1085 \u1077  \u1091 \u1093 \u1086 \u1076 \u1080 \u1090 \u1100  \u1075 \u1083 \u1091 \u1073 \u1086 \u1082 \u1086  \u1074  \u1101 \u1079 \u1086 \u1090 \u1077 \u1088 \u1080 \u1082 \u1091  \u1080  \u1091 \u1076 \u1077 \u1088 \u1078 \u1080 \u1074 \u1072 \u1090 \u1100  \u1090 \u1086 \u1085 \u1082 \u1080 \u1081  \u1073 \u1072 \u1083 \u1072 \u1085 \u1089 .\
\uc0\u1042 \u1077 \u1076 \u1091 \u1097 \u1072 \u1103 : \u1053 \u1091 \u1078 \u1085 \u1099  \u1083 \u1080  \u1087 \u1086 \u1103 \u1089 \u1085 \u1077 \u1085 \u1080 \u1103  \u1082  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1072 \u1084 ?\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1094 \u1072 : \u1044 \u1072 . \u1054 \u1089 \u1086 \u1073 \u1077 \u1085 \u1085 \u1086  \u1087 \u1077 \u1088 \u1077 \u1076  \u1087 \u1077 \u1088 \u1074 \u1086 \u1081  \u1089 \u1077 \u1089 \u1089 \u1080 \u1077 \u1081  \u1076 \u1099 \u1093 \u1072 \u1085 \u1080 \u1103  \u1091  \u1084 \u1077 \u1085 \u1103  \u1073 \u1099 \u1083  \u1089 \u1090 \u1088 \u1072 \u1093 : \u1095 \u1090 \u1086  \u1073 \u1091 \u1076 \u1077 \u1090  \u1089  \u1090 \u1077 \u1083 \u1086 \u1084 , \u1075 \u1080 \u1087 \u1077 \u1088 \u1074 \u1077 \u1085 \u1090 \u1080 \u1083 \u1103 \u1094 \u1080 \u1103  \u1080  \u1090 . \u1087 . \u1055 \u1086 \u1084 \u1086 \u1075  \u1073 \u1099  \u1082 \u1086 \u1088 \u1086 \u1090 \u1082 \u1080 \u1081  \u1087 \u1086 \u1085 \u1103 \u1090 \u1085 \u1099 \u1081  \u1090 \u1077 \u1082 \u1089 \u1090 : \u1087 \u1086 \u1095 \u1077 \u1084 \u1091  \u1087 \u1088 \u1086 \u1080 \u1089 \u1093 \u1086 \u1076 \u1103 \u1090  \u1086 \u1097 \u1091 \u1097 \u1077 \u1085 \u1080 \u1103 , \u1087 \u1086 \u1095 \u1077 \u1084 \u1091  \u1101 \u1090 \u1086  \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 , \u1082 \u1091 \u1076 \u1072  \u1101 \u1090 \u1086  \u1074 \u1077 \u1076 \u1105 \u1090 , \u1082 \u1072 \u1082 \u1080 \u1077  \u1084 \u1086 \u1075 \u1091 \u1090  \u1073 \u1099 \u1090 \u1100  \u1074 \u1080 \u1079 \u1091 \u1072 \u1083 \u1099 /\u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1103 .\
