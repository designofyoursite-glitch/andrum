\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1061 \u1086 \u1095 \u1077 \u1090 \u1089 \u1103  \u1074 \u1077 \u1088 \u1080 \u1090 \u1100 . \u1071  \u1077 \u1097 \u1105  \u1085 \u1077  \u1087 \u1088 \u1086 \u1074 \u1077 \u1088 \u1103 \u1083 \u1072  \u1101 \u1090 \u1086  \u1075 \u1083 \u1091 \u1073 \u1086 \u1082 \u1086  \u1080  \u1085 \u1072 \u1076 \u1086 \u1083 \u1075 \u1086 , \u1085 \u1086  \u1087 \u1086 \u1089 \u1083 \u1077 \u1076 \u1085 \u1080 \u1077  \u1082 \u1072 \u1089 \u1072 \u1085 \u1080 \u1103  \u1089  \u1084 \u1091 \u1078 \u1095 \u1080 \u1085 \u1072 \u1084 \u1080  \'97 \u1073 \u1077 \u1079  \u1087 \u1088 \u1077 \u1078 \u1085 \u1080 \u1093  \u1074 \u1089 \u1087 \u1099 \u1096 \u1077 \u1082  \u1090 \u1088 \u1077 \u1074 \u1086 \u1075 \u1080  \u1085 \u1072  \u1090 \u1077  \u1078 \u1077  \u1089 \u1080 \u1090 \u1091 \u1072 \u1094 \u1080 \u1080 . \u1042 \u1080 \u1078 \u1091  \u1087 \u1088 \u1086 \u1075 \u1088 \u1077 \u1089 \u1089  \u1074  \u1089 \u1090 \u1086 \u1088 \u1086 \u1085 \u1091  \u1073 \u1086 \u1083 \u1077 \u1077  \u1079 \u1076 \u1086 \u1088 \u1086 \u1074 \u1086 \u1081  \u1087 \u1088 \u1080 \u1074 \u1103 \u1079 \u1072 \u1085 \u1085 \u1086 \u1089 \u1090 \u1080 . \u1061 \u1086 \u1090 \u1103  \u1085 \u1077  \u1079 \u1085 \u1072 \u1102 , \u1095 \u1090 \u1086  \u1073 \u1099 \u1083 \u1086  \u1073 \u1099 , \u1077 \u1089 \u1083 \u1080  \u1073 \u1099  \u1089 \u1085 \u1086 \u1074 \u1072  \u1089 \u1080 \u1083 \u1100 \u1085 \u1086  \u1074 \u1083 \u1102 \u1073 \u1080 \u1083 \u1072 \u1089 \u1100 .\
\uc0\u1042 \u1077 \u1076 \u1091 \u1097 \u1080 \u1081 : \u1045 \u1089 \u1083 \u1080  \u1074 \u1089 \u1087 \u1086 \u1084 \u1085 \u1080 \u1090 \u1100  \u1090 \u1091  \u1080 \u1089 \u1090 \u1086 \u1088 \u1080 \u1102 , \u1082 \u1072 \u1082  \u1090 \u1099  \u1087 \u1088 \u1086 \u1078 \u1080 \u1074 \u1072 \u1083 \u1072  \u1090 \u1088 \u1077 \u1074 \u1086 \u1078 \u1085 \u1099 \u1077  \u1087 \u1077 \u1088 \u1080 \u1086 \u1076 \u1099 ? \u1063 \u1090 \u1086  \u1087 \u1088 \u1086 \u1080 \u1089 \u1093 \u1086 \u1076 \u1080 \u1083 \u1086  \u1074  \u1084 \u1099 \u1089 \u1083 \u1103 \u1093 , \u1090 \u1077 \u1083 \u1077 ?\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1069 \u1090 \u1086  \u1073 \u1099 \u1083 \u1080  \u1087 \u1077 \u1088 \u1080 \u1086 \u1076 \u1099  \u1103 \u1088 \u1082 \u1086 \u1075 \u1086  \u1101 \u1084 \u1086 \u1094 \u1080 \u1086 \u1085 \u1072 \u1083 \u1100 \u1085 \u1086 \u1075 \u1086  \u1076 \u1080 \u1089 \u1082 \u1086 \u1084 \u1092 \u1086 \u1088 \u1090 \u1072 . \u1059  \u1084 \u1077 \u1085 \u1103  \'ab\u1083 \u1086 \u1084 \u1072 \u1083 \u1089 \u1103  \u1084 \u1086 \u1079 \u1075 \'bb: \u1089 \u1080 \u1083 \u1100 \u1085 \u1086 \u1077  \u1085 \u1077 \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1085 \u1080 \u1077 , \u1087 \u1086 \u1095 \u1077 \u1084 \u1091  \u1090 \u1072 \u1082  \u1087 \u1088 \u1086 \u1080 \u1089 \u1093 \u1086 \u1076 \u1080 \u1090 . \u1041 \u1077 \u1089 \u1082 \u1086 \u1085 \u1077 \u1095 \u1085 \u1099 \u1077  \u1074 \u1086 \u1087 \u1088 \u1086 \u1089 \u1099 : \u1095 \u1090 \u1086  \u1085 \u1077  \u1090 \u1072 \u1082 , \u1087 \u1086 \u1095 \u1077 \u1084 \u1091  \u1086 \u1085  \u1090 \u1072 \u1082  \u1089 \u1076 \u1077 \u1083 \u1072 \u1083 , \u1095 \u1090 \u1086  \u1089 \u1086  \u1084 \u1085 \u1086 \u1081  \u1085 \u1077  \u1090 \u1072 \u1082 . \u1041 \u1091 \u1076 \u1090 \u1086  \u1085 \u1077 \u1081 \u1088 \u1086 \u1085 \u1085 \u1099 \u1077  \u1089 \u1074 \u1103 \u1079 \u1080  \u1076 \u1072 \u1074 \u1072 \u1083 \u1080  \u1089 \u1073 \u1086 \u1081  \'97 \u1084 \u1086 \u1105  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1085 \u1080 \u1077  \u1084 \u1080 \u1088 \u1072  \u1085 \u1077  \u1074 \u1084 \u1077 \u1097 \u1072 \u1083 \u1086  \u1087 \u1088 \u1086 \u1080 \u1089 \u1093 \u1086 \u1076 \u1103 \u1097 \u1077 \u1077 .\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1053 \u1072  \u1091 \u1088 \u1086 \u1074 \u1085 \u1077  \u1091 \u1084 \u1072  \'97 \u1089 \u1080 \u1083 \u1100 \u1085 \u1086 \u1077 , \u1085 \u1077  \u1087 \u1088 \u1077 \u1082 \u1088 \u1072 \u1097 \u1072 \u1102 \u1097 \u1077 \u1077 \u1089 \u1103  \u1085 \u1072 \u1087 \u1088 \u1103 \u1078 \u1077 \u1085 \u1080 \u1077 . \u1053 \u1072  \u1091 \u1088 \u1086 \u1074 \u1085 \u1077  \u1090 \u1077 \u1083 \u1072  \'97 \u1087 \u1086 \u1074 \u1099 \u1096 \u1077 \u1085 \u1085 \u1086 \u1077  \u1089 \u1077 \u1088 \u1076 \u1094 \u1077 \u1073 \u1080 \u1077 \u1085 \u1080 \u1077 , \u1073 \u1088 \u1086 \u1089 \u1072 \u1083 \u1086  \u1074  \u1078 \u1072 \u1088 . \u1071  \u1095 \u1091 \u1074 \u1089 \u1090 \u1074 \u1086 \u1074 \u1072 \u1083 \u1072  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1077  \u1074 \u1099 \u1089 \u1086 \u1082 \u1086 \u1075 \u1086  \u1082 \u1086 \u1088 \u1090 \u1080 \u1079 \u1086 \u1083 \u1072 : \u1074 \u1085 \u1091 \u1090 \u1088 \u1077 \u1085 \u1085 \u1102 \u1102  \u1084 \u1072 \u1085 \u1076 \u1088 \u1072 \u1078 \u1082 \u1091 . \u1055 \u1088 \u1080  \u1101 \u1090 \u1086 \u1084  \u1101 \u1084 \u1086 \u1094 \u1080 \u1086 \u1085 \u1072 \u1083 \u1100 \u1085 \u1086  \u1089 \u1083 \u1086 \u1074 \u1085 \u1086  \'ab\u1079 \u1072 \u1084 \u1086 \u1088 \u1086 \u1079 \u1082 \u1072 \'bb: \u1089 \u1083 \u1086 \u1078 \u1085 \u1086  \u1074 \u1099 \u1088 \u1072 \u1079 \u1080 \u1090 \u1100  \u1095 \u1091 \u1074 \u1089 \u1090 \u1074 \u1072 , \u1087 \u1086 \u1090 \u1086 \u1084 \u1091  \u1095 \u1090 \u1086  \u1085 \u1077  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1083 \u1072  \u1087 \u1088 \u1080 \u1095 \u1080 \u1085 . \u1042 \u1085 \u1091 \u1090 \u1088 \u1080  \u1074 \u1089 \u1105  \u1082 \u1086 \u1083 \u1086 \u1090 \u1080 \u1090 \u1089 \u1103 , \u1072  \u1089 \u1085 \u1072 \u1088 \u1091 \u1078 \u1080  \'97 \u1089 \u1090 \u1091 \u1087 \u1086 \u1088 .\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1052 \u1099 \u1089 \u1083 \u1080  \u1089 \u1090 \u1072 \u1085 \u1086 \u1074 \u1080 \u1083 \u1080 \u1089 \u1100  \u1085 \u1072 \u1074 \u1103 \u1079 \u1095 \u1080 \u1074 \u1099 \u1084 \u1080 : \u1082 \u1088 \u1091 \u1090 \u1103 \u1090 \u1089 \u1103 , \u1087 \u1099 \u1090 \u1072 \u1102 \u1090 \u1089 \u1103  \u1085 \u1072 \u1081 \u1090 \u1080  \u1086 \u1073 \u1098 \u1103 \u1089 \u1085 \u1077 \u1085 \u1080 \u1077 . \u1048 \u1079 -\u1079 \u1072  \u1090 \u1086 \u1075 \u1086 , \u1095 \u1090 \u1086  \u1077 \u1075 \u1086  \u1085 \u1077 \u1090 , \u1103  \u1079 \u1072 \u1089 \u1090 \u1088 \u1077 \u1074 \u1072 \u1083 \u1072  \u1074  \u1087 \u1077 \u1090 \u1083 \u1077  \u1086 \u1073 \u1098 \u1103 \u1089 \u1085 \u1077 \u1085 \u1080 \u1081  \'97 \u1095 \u1090 \u1086 \u1073 \u1099  \u1089 \u1090 \u1072 \u1083 \u1086  \u1089 \u1087 \u1086 \u1082 \u1086 \u1081 \u1085 \u1077 \u1077 . \u1053 \u1086  \u1101 \u1090 \u1086  \u1085 \u1077  \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1083 \u1086 . \u1055 \u1072 \u1088 \u1090 \u1085 \u1105 \u1088  \u1073 \u1099 \u1083  \u1089  \u1080 \u1079 \u1073 \u1077 \u1075 \u1072 \u1102 \u1097 \u1080 \u1084  \u1090 \u1080 \u1087 \u1086 \u1084 ; \u1073 \u1099 \u1083 \u1086  \u1089 \u1083 \u1086 \u1078 \u1085 \u1086  \u1087 \u1086 \u1083 \u1091 \u1095 \u1080 \u1090 \u1100  \u1086 \u1090  \u1085 \u1077 \u1075 \u1086  \u1074 \u1090 \u1086 \u1088 \u1091 \u1102  \u1087 \u1086 \u1083 \u1086 \u1074 \u1080 \u1085 \u1091  \u1082 \u1086 \u1085 \u1090 \u1072 \u1082 \u1090 \u1072 . \u1042 \u1086 \u1079 \u1085 \u1080 \u1082 \u1072 \u1083 \u1072  \u1086 \u1076 \u1077 \u1088 \u1078 \u1080 \u1084 \u1086 \u1089 \u1090 \u1100  \u1087 \u1086 \u1083 \u1091 \u1095 \u1080 \u1090 \u1100  \u1086 \u1073 \u1088 \u1072 \u1090 \u1085 \u1091 \u1102  \u1089 \u1074 \u1103 \u1079 \u1100 : \u1089 \u1087 \u1088 \u1086 \u1089 \u1080 \u1090 \u1100 , \u1087 \u1088 \u1086 \u1103 \u1089 \u1085 \u1080 \u1090 \u1100 . \u1054 \u1085  \u1084 \u1086 \u1075  \u1076 \u1086 \u1083 \u1075 \u1086  \u1085 \u1077  \u1086 \u1090 \u1074 \u1077 \u1095 \u1072 \u1090 \u1100 . \u1061 \u1086 \u1090 \u1077 \u1083 \u1086 \u1089 \u1100  \u1088 \u1077 \u1096 \u1080 \u1090 \u1100  \u1074 \u1089 \u1105  \'ab\u1079 \u1076 \u1077 \u1089 \u1100  \u1080  \u1089 \u1077 \u1081 \u1095 \u1072 \u1089 \'bb, \u1085 \u1086  \u1090 \u1072 \u1082 \u1086 \u1081  \u1074 \u1086 \u1079 \u1084 \u1086 \u1078 \u1085 \u1086 \u1089 \u1090 \u1080  \u1085 \u1077  \u1073 \u1099 \u1083 \u1086  \'97 \u1080  \u1101 \u1090 \u1086  \u1088 \u1074 \u1072 \u1083 \u1086  \u1080 \u1079 \u1085 \u1091 \u1090 \u1088 \u1080 .\
\uc0\u1042 \u1077 \u1076 \u1091 \u1097 \u1080 \u1081 : \u1071  \u1089 \u1083 \u1099 \u1096 \u1091 , \u1095 \u1090 \u1086  \u1090 \u1099  \u1086 \u1087 \u1080 \u1088 \u1072 \u1077 \u1096 \u1100 \u1089 \u1103  \u1085 \u1072  \u1082 \u1086 \u1085 \u1082 \u1088 \u1077 \u1090 \u1085 \u1099 \u1077  \u1089 \u1080 \u1090 \u1091 \u1072 \u1094 \u1080 \u1080 : \'ab\u1085 \u1077  \u1086 \u1090 \u1074 \u1077 \u1095 \u1072 \u1083 \'bb, \'ab\u1073 \u1088 \u1072 \u1083  \u1074 \u1088 \u1077 \u1084 \u1103 \'bb. \u1069 \u1090 \u1086  \u1073 \u1099 \u1083 \u1086  \u1092 \u1086 \u1085 \u1086 \u1074 \u1086 \u1077  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1077  \u1090 \u1088 \u1077 \u1074 \u1086 \u1075 \u1080  \u1080 \u1083 \u1080  \u1074 \u1089 \u1087 \u1083 \u1077 \u1089 \u1082 \u1080  \u1074  \u1086 \u1090 \u1076 \u1077 \u1083 \u1100 \u1085 \u1099 \u1093  \u1101 \u1087 \u1080 \u1079 \u1086 \u1076 \u1072 \u1093 ?\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1048  \u1090 \u1086 , \u1080  \u1076 \u1088 \u1091 \u1075 \u1086 \u1077 . \u1060 \u1086 \u1085 \u1086 \u1084  \'97 \u1085 \u1077 \u1087 \u1088 \u1077 \u1076 \u1089 \u1082 \u1072 \u1079 \u1091 \u1077 \u1084 \u1086 \u1089 \u1090 \u1100 , \u1085 \u1077 \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 \u1089 \u1090 \u1100 , \u1085 \u1077 \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1085 \u1080 \u1077 , \u1085 \u1072 \u1089 \u1082 \u1086 \u1083 \u1100 \u1082 \u1086  \u1086 \u1085  \u1079 \u1072 \u1080 \u1085 \u1090 \u1077 \u1088 \u1077 \u1089 \u1086 \u1074 \u1072 \u1085 . \u1042 \u1088 \u1086 \u1076 \u1077  \u1076 \u1072 , \u1085 \u1086  \u1088 \u1072 \u1079 \u1084 \u1099 \u1090 \u1086 . \u1069 \u1090 \u1086  \u1076 \u1072 \u1074 \u1072 \u1083 \u1086  \u1087 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1085 \u1091 \u1102  \u1090 \u1088 \u1077 \u1074 \u1086 \u1075 \u1091 . \u1055 \u1083 \u1102 \u1089  \u1073 \u1099 \u1083 \u1080  \u1087 \u1080 \u1082 \u1086 \u1074 \u1099 \u1077  \u1101 \u1087 \u1080 \u1079 \u1086 \u1076 \u1099 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1077  \u1087 \u1088 \u1080 \u1093 \u1086 \u1076 \u1080 \u1083 \u1086 \u1089 \u1100  \u1088 \u1072 \u1079 \u1088 \u1091 \u1083 \u1080 \u1074 \u1072 \u1090 \u1100  \u1074  \u1082 \u1086 \u1084 \u1084 \u1091 \u1085 \u1080 \u1082 \u1072 \u1094 \u1080 \u1080 . \u1060 \u1086 \u1085 \u1086 \u1074 \u1086 \u1077  \u1088 \u1072 \u1079 \u1075 \u1086 \u1074 \u1086 \u1088 \u1086 \u1084  \u1085 \u1077  \u1089 \u1085 \u1080 \u1084 \u1072 \u1083 \u1086 \u1089 \u1100 : \u1103  \u1087 \u1099 \u1090 \u1072 \u1083 \u1072 \u1089 \u1100 , \u1085 \u1086  \u1103 \u1089 \u1085 \u1086 \u1089 \u1090 \u1100  \u1087 \u1088 \u1080 \u1093 \u1086 \u1076 \u1080 \u1083 \u1072  \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1089 \u1087 \u1091 \u1089 \u1090 \u1103  \u1074 \u1088 \u1077 \u1084 \u1103 .\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1055 \u1086 \u1089 \u1090 \u1077 \u1087 \u1077 \u1085 \u1085 \u1086  \u1103  \u1087 \u1086 \u1085 \u1103 \u1083 \u1072 , \u1095 \u1090 \u1086  \u1089 \u1083 \u1086 \u1074 \u1072  \u1085 \u1077  \u1089 \u1086 \u1074 \u1087 \u1072 \u1076 \u1072 \u1083 \u1080  \u1089  \u1076 \u1077 \u1081 \u1089 \u1090 \u1074 \u1080 \u1103 \u1084 \u1080 . \u1053 \u1072  \u1089 \u1083 \u1086 \u1074 \u1072 \u1093  \'97 \u1080 \u1085 \u1090 \u1077 \u1088 \u1077 \u1089  \u1080  \u1086 \u1076 \u1085 \u1072  \u1076 \u1080 \u1085 \u1072 \u1084 \u1080 \u1082 \u1072 , \u1072  \u1076 \u1077 \u1081 \u1089 \u1090 \u1074 \u1080 \u1103  \u1087 \u1086 \u1082 \u1072 \u1079 \u1099 \u1074 \u1072 \u1083 \u1080  \u1076 \u1088 \u1091 \u1075 \u1091 \u1102 . \u1059  \u1084 \u1077 \u1085 \u1103  \u1085 \u1077  \u1073 \u1099 \u1083 \u1086  \u1085 \u1072 \u1074 \u1099 \u1082 \u1072  \u1086 \u1087 \u1080 \u1088 \u1072 \u1090 \u1100 \u1089 \u1103  \u1085 \u1072  \u1076 \u1077 \u1081 \u1089 \u1090 \u1074 \u1080 \u1103  \'97 \u1103  \u1074 \u1077 \u1088 \u1080 \u1083 \u1072  \u1089 \u1083 \u1086 \u1074 \u1072 \u1084  \u1080  \u1074 \u1077 \u1083 \u1072  \u1083 \u1080 \u1085 \u1080 \u1102  \'ab\u1082 \u1072 \u1082  \u1073 \u1091 \u1076 \u1090 \u1086  \u1073 \u1099  \u1074 \u1089 \u1105  \u1086 \u1082 \'bb. \u1055 \u1086 \u1090 \u1086 \u1084  \u1088 \u1077 \u1072 \u1083 \u1100 \u1085 \u1086 \u1089 \u1090 \u1100  \u1087 \u1086 \u1082 \u1072 \u1079 \u1099 \u1074 \u1072 \u1083 \u1072  \u1088 \u1072 \u1079 \u1088 \u1099 \u1074 , \u1080  \u1101 \u1090 \u1086 \u1090  \u1088 \u1072 \u1079 \u1088 \u1099 \u1074  \u1080  \u1088 \u1086 \u1078 \u1076 \u1072 \u1083  \u1090 \u1088 \u1077 \u1074 \u1086 \u1075 \u1091 : \u1084 \u1085 \u1077  \u1075 \u1086 \u1074 \u1086 \u1088 \u1103 \u1090  \u1086 \u1076 \u1085 \u1086 , \u1072  \u1087 \u1088 \u1086 \u1080 \u1089 \u1093 \u1086 \u1076 \u1103 \u1090  \u1076 \u1088 \u1091 \u1075 \u1080 \u1077  \u1074 \u1077 \u1097 \u1080 . \u1054 \u1090 \u1089 \u1102 \u1076 \u1072  \'97 \u1085 \u1077 \u1091 \u1074 \u1077 \u1088 \u1077 \u1085 \u1085 \u1086 \u1089 \u1090 \u1100 , \u1085 \u1091 \u1078 \u1085 \u1072  \u1083 \u1080  \u1103  \u1074 \u1086 \u1086 \u1073 \u1097 \u1077 , \u1079 \u1072 \u1080 \u1085 \u1090 \u1077 \u1088 \u1077 \u1089 \u1086 \u1074 \u1072 \u1085  \u1083 \u1080  \u1086 \u1085 .\
\uc0\u1042 \u1077 \u1076 \u1091 \u1097 \u1080 \u1081 : \u1052 -\u1084 .\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1050 \u1086 \u1085 \u1082 \u1088 \u1077 \u1090 \u1085 \u1099 \u1077  \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 \u1099 ? \u1055 \u1077 \u1088 \u1077 \u1087 \u1080 \u1089 \u1082 \u1080  \u1080  \u1086 \u1090 \u1074 \u1077 \u1090 \u1099 . \u1052 \u1099  \u1086 \u1073 \u1089 \u1091 \u1078 \u1076 \u1072 \u1077 \u1084  \u1091 \u1103 \u1079 \u1074 \u1080 \u1084 \u1091 \u1102  \u1090 \u1077 \u1084 \u1091 , \u1072  \u1086 \u1085  \u1090 \u1088 \u1080  \u1076 \u1085 \u1103  \u1085 \u1077  \u1086 \u1090 \u1074 \u1077 \u1095 \u1072 \u1077 \u1090  \u1085 \u1072  \u1074 \u1072 \u1078 \u1085 \u1086 \u1077  \u1089 \u1086 \u1086 \u1073 \u1097 \u1077 \u1085 \u1080 \u1077 . \u1044 \u1083 \u1103  \u1084 \u1077 \u1085 \u1103  \u1101 \u1090 \u1086  \u1073 \u1099 \u1083  \u1087 \u1077 \u1088 \u1074 \u1099 \u1081  \u1086 \u1087 \u1099 \u1090  \'ab\u1088 \u1072 \u1089 \u1090 \u1103 \u1085 \u1091 \u1090 \u1086 \u1081  \u1082 \u1086 \u1084 \u1084 \u1091 \u1085 \u1080 \u1082 \u1072 \u1094 \u1080 \u1080 \'bb. \u1071  \u1087 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1085 \u1086  \u1087 \u1088 \u1086 \u1074 \u1077 \u1088 \u1103 \u1083 \u1072  \u1090 \u1077 \u1083 \u1077 \u1092 \u1086 \u1085 , \u1083 \u1086 \u1074 \u1080 \u1083 \u1072  \u1082 \u1072 \u1078 \u1076 \u1091 \u1102  \u1074 \u1080 \u1073 \u1088 \u1072 \u1094 \u1080 \u1102 . \u1054 \u1085  \u1084 \u1086 \u1075  \u1085 \u1072  \u1085 \u1077 \u1076 \u1077 \u1083 \u1102  \u1087 \u1088 \u1086 \u1087 \u1072 \u1089 \u1090 \u1100 , \u1076 \u1072 \u1078 \u1077  \u1073 \u1077 \u1079  \u1082 \u1086 \u1085 \u1092 \u1083 \u1080 \u1082 \u1090 \u1072  \'97 \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  \u1079 \u1072 \u1085 \u1080 \u1084 \u1072 \u1083 \u1089 \u1103  \u1089 \u1074 \u1086 \u1077 \u1081  \u1078 \u1080 \u1079 \u1085 \u1100 \u1102 . \u1048  \u1091  \u1084 \u1077 \u1085 \u1103  \u1085 \u1072 \u1095 \u1080 \u1085 \u1072 \u1083 \u1086 \u1089 \u1100  \u1082 \u1086 \u1087 \u1072 \u1085 \u1080 \u1077 : \u1095 \u1090 \u1086  \u1085 \u1077  \u1090 \u1072 \u1082 , \u1095 \u1090 \u1086  \u1103  \u1089 \u1076 \u1077 \u1083 \u1072 \u1083 \u1072 , \u1082 \u1072 \u1082  \u1085 \u1091 \u1078 \u1085 \u1086  \u1073 \u1099 \u1083 \u1086  \u1085 \u1072 \u1087 \u1080 \u1089 \u1072 \u1090 \u1100 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1085 \u1077  \u1089 \u1087 \u1088 \u1086 \u1074 \u1086 \u1094 \u1080 \u1088 \u1086 \u1074 \u1072 \u1090 \u1100  \u1101 \u1090 \u1086 . \u1055 \u1086 \u1076 \u1085 \u1080 \u1084 \u1072 \u1083 \u1072  \u1089 \u1090 \u1072 \u1088 \u1099 \u1077  \u1087 \u1077 \u1088 \u1077 \u1087 \u1080 \u1089 \u1082 \u1080 , \u1080 \u1089 \u1082 \u1072 \u1083 \u1072 , \u1075 \u1076 \u1077  \'ab\u1086 \u1096 \u1080 \u1073 \u1083 \u1072 \u1089 \u1100 \'bb. \u1055 \u1086 \u1103 \u1074 \u1083 \u1103 \u1083 \u1086 \u1089 \u1100  \u1089 \u1072 \u1084 \u1086 \u1091 \u1087 \u1088 \u1105 \u1082  \u1080  \u1089 \u1072 \u1084 \u1086 \u1082 \u1086 \u1087 \u1072 \u1085 \u1080 \u1077 : \'ab\u1103  \u1085 \u1077 \u1076 \u1086 \u1089 \u1090 \u1072 \u1090 \u1086 \u1095 \u1085 \u1086  \u1088 \u1072 \u1089 \u1089 \u1083 \u1072 \u1073 \u1083 \u1077 \u1085 \u1085 \u1072 \u1103 \'bb, \'ab\u1085 \u1077 \u1076 \u1086 \u1089 \u1090 \u1072 \u1090 \u1086 \u1095 \u1085 \u1086  \u1074 \u1085 \u1080 \u1084 \u1072 \u1090 \u1077 \u1083 \u1100 \u1085 \u1072 \u1103 \'bb. \u1069 \u1090 \u1086  \u1089 \u1095 \u1080 \u1090 \u1099 \u1074 \u1072 \u1083 \u1086 \u1089 \u1100 , \u1074 \u1083 \u1080 \u1103 \u1083 \u1086  \u1085 \u1072  \u1086 \u1090 \u1085 \u1086 \u1096 \u1077 \u1085 \u1080 \u1077  \u1082 \u1086  \u1084 \u1085 \u1077  \'97 \u1080  \u1094 \u1080 \u1082 \u1083  \u1087 \u1088 \u1086 \u1076 \u1086 \u1083 \u1078 \u1072 \u1083 \u1089 \u1103 .\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1045 \u1097 \u1105  \u1090 \u1088 \u1077 \u1074 \u1086 \u1075 \u1072  \u1074 \u1082 \u1083 \u1102 \u1095 \u1072 \u1083 \u1072 \u1089 \u1100 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1086 \u1085  \u1091 \u1077 \u1079 \u1078 \u1072 \u1083  \u1085 \u1072  \u1089 \u1074 \u1086 \u1080  \u1084 \u1077 \u1088 \u1086 \u1087 \u1088 \u1080 \u1103 \u1090 \u1080 \u1103 , \u1080  \u1074  \u1094 \u1077 \u1083 \u1086 \u1084  \u1080 \u1079 -\u1079 \u1072  \u1077 \u1075 \u1086  \u1079 \u1072 \u1082 \u1088 \u1099 \u1090 \u1086 \u1089 \u1090 \u1080 . \u1050 \u1086 \u1085 \u1090 \u1077 \u1082 \u1089 \u1090 : \u1086 \u1085  \u1074  \u1090 \u1091 \u1089 \u1086 \u1074 \u1082 \u1077  \u1074 \u1086 \u1076 \u1085 \u1099 \u1093  \u1090 \u1077 \u1088 \u1072 \u1087 \u1077 \u1074 \u1090 \u1086 \u1074 , \u1088 \u1077 \u1090 \u1088 \u1080 \u1090 \u1099 , \u1084 \u1085 \u1086 \u1075 \u1086  \u1076 \u1077 \u1074 \u1091 \u1096 \u1077 \u1082 , \u1076 \u1088 \u1091 \u1079 \u1100 \u1103 . \u1050 \u1086 \u1075 \u1076 \u1072  \u1086 \u1085  \u1087 \u1088 \u1086 \u1074 \u1086 \u1076 \u1080 \u1083  \u1074 \u1088 \u1077 \u1084 \u1103  \u1090 \u1072 \u1084 , \u1103  \u1085 \u1077  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1083 \u1072 , \u1095 \u1090 \u1086  \u1087 \u1088 \u1086 \u1080 \u1089 \u1093 \u1086 \u1076 \u1080 \u1090 . \u1071  \u1080 \u1089 \u1082 \u1072 \u1083 \u1072  \'ab\u1076 \u1074 \u1077 \u1088 \u1100 \'bb \'97 \u1087 \u1088 \u1086 \u1079 \u1088 \u1072 \u1095 \u1085 \u1086 \u1089 \u1090 \u1100 . \u1045 \u1105  \u1085 \u1077  \u1073 \u1099 \u1083 \u1086 . \u1051 \u1077 \u1079 \u1083 \u1072  \u1074  \u1072 \u1082 \u1082 \u1072 \u1091 \u1085 \u1090 \u1099 , \u1095 \u1080 \u1090 \u1072 \u1083 \u1072  \u1082 \u1086 \u1084 \u1084 \u1077 \u1085 \u1090 \u1072 \u1088 \u1080 \u1080 , \u1083 \u1072 \u1081 \u1082 \u1080 , \'ab\u1072 \u1081  \u1083 \u1072 \u1074  \u1102 \'bb \'97 \u1080  \u1085 \u1072 \u1082 \u1088 \u1099 \u1074 \u1072 \u1083 \u1086  \u1078 \u1072 \u1088 \u1086 \u1084 . \u1071  \u1080 \u1089 \u1082 \u1072 \u1083 \u1072  \u1087 \u1086 \u1076 \u1090 \u1074 \u1077 \u1088 \u1078 \u1076 \u1077 \u1085 \u1080 \u1077 , \u1095 \u1090 \u1086  \u1086 \u1085  \u1080 \u1079 \u1084 \u1077 \u1085 \u1080 \u1090 , \u1073 \u1088 \u1086 \u1089 \u1080 \u1090 , \u1087 \u1086 \u1089 \u1090 \u1072 \u1074 \u1080 \u1090  \u1084 \u1077 \u1085 \u1103  \u1085 \u1072  \u1087 \u1086 \u1089 \u1083 \u1077 \u1076 \u1085 \u1077 \u1077  \u1084 \u1077 \u1089 \u1090 \u1086 . \u1053 \u1072  \u1089 \u1083 \u1086 \u1074 \u1072 \u1093  \u1086 \u1085  \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1083 : \'ab\u1044 \u1072 \u1074 \u1072 \u1081  \u1076 \u1086 \u1074 \u1077 \u1088 \u1103 \u1090 \u1100  \u1089 \u1074 \u1103 \u1079 \u1080 \'bb, \'97 \u1072  \u1091  \u1085 \u1077 \u1075 \u1086  \u1073 \u1099 \u1083 \u1072  \u1089 \u1074 \u1086 \u1103  \u1078 \u1080 \u1079 \u1085 \u1100 , \u1080  \u1084 \u1085 \u1077  \u1101 \u1090 \u1086  \u1073 \u1099 \u1083 \u1086  \u1085 \u1077 \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 .\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1050 \u1086 \u1075 \u1076 \u1072  \u1086 \u1085  \u1087 \u1088 \u1072 \u1082 \u1090 \u1080 \u1082 \u1086 \u1074 \u1072 \u1083  \u1074 \u1086 \u1076 \u1085 \u1091 \u1102  \u1090 \u1077 \u1088 \u1072 \u1087 \u1080 \u1102  \u1089  \u1087 \u1086 \u1083 \u1091 \u1075 \u1086 \u1083 \u1099 \u1084 \u1080  \u1082 \u1083 \u1080 \u1077 \u1085 \u1090 \u1082 \u1072 \u1084 \u1080 , \u1076 \u1083 \u1103  \u1084 \u1077 \u1085 \u1103  \u1101 \u1090 \u1086  \u1073 \u1099 \u1083 \u1086  \u1086 \u1089 \u1090 \u1088 \u1086 . \u1042 \u1082 \u1083 \u1102 \u1095 \u1072 \u1083 \u1089 \u1103  \u1082 \u1086 \u1085 \u1090 \u1088 \u1086 \u1083 \u1100 : \u1093 \u1086 \u1090 \u1077 \u1083 \u1086 \u1089 \u1100  \u1079 \u1085 \u1072 \u1090 \u1100  \'97 \u1089  \u1082 \u1077 \u1084 , \u1087 \u1086 \u1095 \u1077 \u1084 \u1091  \u1085 \u1077  \u1089 \u1086  \u1084 \u1085 \u1086 \u1081 . \u1059 \u1084  \u1088 \u1080 \u1089 \u1086 \u1074 \u1072 \u1083  \u1082 \u1072 \u1088 \u1090 \u1080 \u1085 \u1082 \u1080  \u1085 \u1077  \u1074  \u1084 \u1086 \u1102  \u1087 \u1086 \u1083 \u1100 \u1079 \u1091 . \u1055 \u1088 \u1086 \u1103 \u1089 \u1085 \u1103 \u1090 \u1100  \u1073 \u1099 \u1083 \u1086  \u1085 \u1077 \u1095 \u1077 \u1084 : \u1084 \u1099  \u1076 \u1072 \u1078 \u1077  \u1085 \u1077  \u1073 \u1099 \u1083 \u1080  \u1074  \u1086 \u1090 \u1085 \u1086 \u1096 \u1077 \u1085 \u1080 \u1103 \u1093  \'97 \u1085 \u1077  \u1073 \u1099 \u1083 \u1086  \'ab\u1087 \u1088 \u1072 \u1074 \u1072  \u1089 \u1087 \u1088 \u1086 \u1089 \u1080 \u1090 \u1100 \'bb. \u1042 \u1086 \u1079 \u1085 \u1080 \u1082 \u1072 \u1083 \u1086  \u1095 \u1091 \u1074 \u1089 \u1090 \u1074 \u1086  \u1073 \u1077 \u1089 \u1087 \u1088 \u1072 \u1074 \u1085 \u1086 \u1089 \u1090 \u1080  \'97 \u1103  \u1090 \u1086 \u1085 \u1091 \u1083 \u1072  \u1074  \u1090 \u1088 \u1077 \u1074 \u1086 \u1075 \u1077 . \u1055 \u1072 \u1088 \u1072 \u1083 \u1083 \u1077 \u1083 \u1100 \u1085 \u1086  \u1096 \u1083 \u1072  \u1080 \u1075 \u1088 \u1072  \u1074  \u1086 \u1073 \u1088 \u1072 \u1079  \'ab\u1084 \u1085 \u1077  \u1086 \u1082 \u1077 \u1081 , \u1103  \u1085 \u1072  \u1095 \u1080 \u1083 \u1077 \'bb. \u1071  \u1090 \u1072 \u1082 \u1086 \u1081  \u1085 \u1077  \u1073 \u1099 \u1083 \u1072 , \u1085 \u1086  \u1087 \u1086 \u1076 \u1076 \u1077 \u1088 \u1078 \u1080 \u1074 \u1072 \u1083 \u1072  \u1086 \u1073 \u1088 \u1072 \u1079 , \u1095 \u1090 \u1086 \u1073 \u1099  \u1085 \u1077  \u1087 \u1086 \u1090 \u1077 \u1088 \u1103 \u1090 \u1100  \u1077 \u1075 \u1086 .\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1041 \u1099 \u1074 \u1072 \u1083 \u1080  \u1082 \u1072 \u1095 \u1077 \u1083 \u1080 : \u1077 \u1089 \u1083 \u1080  \u1095 \u1077 \u1083 \u1086 \u1074 \u1077 \u1082  \u1090 \u1088 \u1080  \u1076 \u1085 \u1103  \u1085 \u1077  \u1086 \u1090 \u1074 \u1077 \u1095 \u1072 \u1077 \u1090  \'97 \'ab\u1074 \u1089 \u1105 , \u1082 \u1086 \u1085 \u1077 \u1094 \'bb, \u1073 \u1083 \u1086 \u1082 \u1080 \u1088 \u1091 \u1102  \u1074  \u1048 \u1085 \u1089 \u1090 \u1072 \u1075 \u1088 \u1072 \u1084 \u1077 , \u1091 \u1076 \u1072 \u1083 \u1103 \u1102  \u1080 \u1079  \u1095 \u1072 \u1090 \u1086 \u1074 ; \u1095 \u1077 \u1088 \u1077 \u1079  \u1085 \u1077 \u1076 \u1077 \u1083 \u1102  \u1088 \u1072 \u1079 \u1073 \u1083 \u1086 \u1082 \u1080 \u1088 \u1091 \u1102 . \u1058 \u1086  \u1079 \u1083 \u1086 \u1089 \u1090 \u1100 : \'ab\u1089 \u1086  \u1084 \u1085 \u1086 \u1081  \u1090 \u1072 \u1082  \u1085 \u1077 \u1083 \u1100 \u1079 \u1103 \'bb, \u1090 \u1086  \'ab\u1103  \u1089 \u1086 \u1089 \u1082 \u1091 \u1095 \u1080 \u1083 \u1072 \u1089 \u1100 , \u1088 \u1072 \u1089 \u1089 \u1082 \u1072 \u1078 \u1080 , \u1082 \u1072 \u1082  \u1090 \u1099 \'bb, \'97 \u1080  \u1075 \u1086 \u1090 \u1086 \u1074 \u1072  \u1087 \u1088 \u1086 \u1089 \u1090 \u1080 \u1090 \u1100 . \u1053 \u1086  \u1082 \u1072 \u1095 \u1077 \u1083 \u1103 \u1084 \u1080  \u1091 \u1087 \u1088 \u1072 \u1074 \u1083 \u1103 \u1083 \u1072  \u1085 \u1077  \u1103  \'97 \u1086 \u1085 . \u1050 \u1072 \u1079 \u1072 \u1083 \u1086 \u1089 \u1100 , \u1086 \u1085  \u1082 \u1086 \u1085 \u1090 \u1088 \u1086 \u1083 \u1080 \u1088 \u1091 \u1077 \u1090  \u1089 \u1080 \u1090 \u1091 \u1072 \u1094 \u1080 \u1102 , \u1072  \u1084 \u1085 \u1077  \u1085 \u1091 \u1078 \u1085 \u1086  \u1078 \u1076 \u1072 \u1090 \u1100 , \u1087 \u1086 \u1076 \u1089 \u1090 \u1088 \u1072 \u1080 \u1074 \u1072 \u1090 \u1100 \u1089 \u1103  \u1087 \u1086 \u1076  \u1077 \u1075 \u1086  \'ab\u1087 \u1088 \u1072 \u1074 \u1080 \u1083 \u1072 \'bb, \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1077  \u1085 \u1077  \u1073 \u1099 \u1083 \u1080  \u1084 \u1085 \u1077  \u1080 \u1079 \u1074 \u1077 \u1089 \u1090 \u1085 \u1099 . \u1069 \u1090 \u1086  \u1080  \u1076 \u1072 \u1074 \u1072 \u1083 \u1086  \u1078 \u1077 \u1089 \u1090 \u1082 \u1091 \u1102  \u1090 \u1088 \u1077 \u1074 \u1086 \u1075 \u1091 .\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1045 \u1097 \u1105  \u1087 \u1086 \u1076 \u1087 \u1080 \u1090 \u1099 \u1074 \u1072 \u1083 \u1086 \u1089 \u1100  \u1101 \u1090 \u1086  \u1084 \u1086 \u1080 \u1084  \u1089 \u1090 \u1088 \u1072 \u1093 \u1086 \u1084  \'ab\u1089 \u1086  \u1084 \u1085 \u1086 \u1081  \u1095 \u1090 \u1086 -\u1090 \u1086  \u1085 \u1077  \u1090 \u1072 \u1082 \'bb. \u1054 \u1085  \u1080 \u1085 \u1086 \u1075 \u1076 \u1072  \u1089 \u1083 \u1086 \u1074 \u1072 \u1084 \u1080  \u1101 \u1090 \u1086  \u1091 \u1089 \u1080 \u1083 \u1080 \u1074 \u1072 \u1083 : \'ab\u1095 \u1090 \u1086  \u1090 \u1099  \u1087 \u1077 \u1088 \u1077 \u1078 \u1080 \u1074 \u1072 \u1077 \u1096 \u1100 \'bb \'97 \u1073 \u1091 \u1076 \u1090 \u1086  \u1087 \u1088 \u1086 \u1073 \u1083 \u1077 \u1084 \u1072  \u1074 \u1086  \u1084 \u1085 \u1077 . \u1048  \u1101 \u1090 \u1086  \u1073 \u1086 \u1083 \u1100 \u1085 \u1086 .\
\uc0\u1042 \u1077 \u1076 \u1091 \u1097 \u1080 \u1081 : \u1057 \u1083 \u1091 \u1096 \u1072 \u1103  \u1101 \u1090 \u1086 , \u1091  \u1084 \u1077 \u1085 \u1103  \u1087 \u1086 \u1076 \u1085 \u1080 \u1084 \u1072 \u1077 \u1090 \u1089 \u1103  \u1084 \u1085 \u1086 \u1075 \u1086  \u1079 \u1083 \u1086 \u1089 \u1090 \u1080  \u1085 \u1072  \u1085 \u1077 \u1075 \u1086 . \u1048  \u1087 \u1088 \u1080  \u1101 \u1090 \u1086 \u1084  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1102 , \u1095 \u1090 \u1086  \u1086 \u1090 \u1074 \u1077 \u1090 \u1089 \u1090 \u1074 \u1077 \u1085 \u1085 \u1086 \u1089 \u1090 \u1100  \u1085 \u1077  \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1085 \u1072  \u1085 \u1105 \u1084 . \u1052 \u1099  \u1089 \u1072 \u1084 \u1080  \u1074 \u1099 \u1073 \u1088 \u1072 \u1083 \u1080  \u1080 \u1075 \u1088 \u1072 \u1090 \u1100  \u1087 \u1086  \u1101 \u1090 \u1080 \u1084  \u1087 \u1088 \u1072 \u1074 \u1080 \u1083 \u1072 \u1084  \'97 \u1085 \u1072 \u1089  \u1085 \u1080 \u1082 \u1090 \u1086  \u1085 \u1077  \u1079 \u1072 \u1089 \u1090 \u1072 \u1074 \u1083 \u1103 \u1083 . \u1048  \u1086 \u1090  \u1101 \u1090 \u1086 \u1075 \u1086  \u1086 \u1089 \u1086 \u1073 \u1077 \u1085 \u1085 \u1086  \u1075 \u1088 \u1091 \u1089 \u1090 \u1085 \u1086 .\
\uc0\u1059 \u1095 \u1072 \u1089 \u1090 \u1085 \u1080 \u1082 : \u1052 -\u1084 .\
\uc0\u1042 \u1077 \u1076 \u1091 \u1097 \u1080 \u1081 : \u1042 \u1089 \u1105 , \u1095 \u1090 \u1086  \u1090 \u1099  \u1086 \u1087 \u1080 \u1089 \u1099 \u1074 \u1072 \u1077 \u1096 \u1100 , \'97 \u1101 \u1090 \u1086  \u1085 \u1072 \u1089 \u1090 \u1086 \u1103 \u1097 \u1072 \u1103  \u1074 \u1086 \u1088 \u1086 \u1085 \u1082 \u1072 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1072 \u1103  \u1086 \u1095 \u1077 \u1085 \u1100  \u1073 \u1099 \u1089 \u1090 \u1088 \u1086  \u1079 \u1072 \u1090 \u1103 \u1075 \u1080 \u1074 \u1072 \u1077 \u1090 . \u1042  \u1090 \u1088 \u1077 \u1074 \u1086 \u1078 \u1085 \u1086 \u1084  \u1089 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1080 \u1080  \u1089 \u1083 \u1086 \u1078 \u1085 \u1086  \u1086 \u1090 \u1089 \u1083 \u1077 \u1076 \u1080 \u1090 \u1100  \u1084 \u1086 \u1084 \u1077 \u1085 \u1090 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1086 \u1085 \u1072  \u1091 \u1078 \u1077  \'ab\u1085 \u1072  \u1087 \u1103 \u1090 \u1082 \u1072 \u1093 \'bb. \u1071  \u1085 \u1077  \u1078 \u1077 \u1083 \u1072 \u1102  \u1085 \u1072 \u1084  \u1089  \u1090 \u1086 \u1073 \u1086 \u1081  \u1089 \u1085 \u1086 \u1074 \u1072  \u1086 \u1082 \u1072 \u1079 \u1099 \u1074 \u1072 \u1090 \u1100 \u1089 \u1103  \u1090 \u1072 \u1084 . \u1055 \u1086 \u1085 \u1103 \u1090 \u1085 \u1086 , \u1095 \u1090 \u1086  \u1101 \u1090 \u1086  \u1085 \u1077  \u1074 \u1089 \u1077 \u1075 \u1076 \u1072  \u1087 \u1086 \u1076  \u1082 \u1086 \u1085 \u1090 \u1088 \u1086 \u1083 \u1077 \u1084  \u1080  \u1095 \u1072 \u1089 \u1090 \u1086  \u1079 \u1072 \u1074 \u1080 \u1089 \u1080 \u1090  \u1086 \u1090  \u1087 \u1072 \u1088 \u1090 \u1085 \u1105 \u1088 \u1072  \'97 \u1087 \u1086 \u1087 \u1072 \u1076 \u1072 \u1102 \u1090 \u1089 \u1103  \u1090 \u1077 , \u1082 \u1090 \u1086  \u1090 \u1088 \u1080 \u1075 \u1075 \u1077 \u1088 \u1080 \u1090  \u1085 \u1077 \u1088 \u1074 \u1085 \u1091 \u1102  \u1089 \u1080 \u1089 \u1090 \u1077 \u1084 \u1091 . \u1057 \u1083 \u1086 \u1078 \u1085 \u1086  \u1087 \u1088 \u1086 \u1090 \u1080 \u1074 \u1086 \u1089 \u1090 \u1086 \u1103 \u1090 \u1100 .\
